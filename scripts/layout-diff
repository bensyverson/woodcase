#!/usr/bin/env python3
"""layout-diff — compare Pen's layout (pen-oracle's <name>.layout.json) with the rects
`woodcase tree --json` prints, id by id; print every rect that differs by more than
0.01 pt (every rect with --all), then a count.

Usage:
    scripts/layout-diff <pen.layout.json> <woodcase-tree.json> [--all]

Both files are parent-relative. Standard library only; runs sandboxed.
"""
import json, sys
pen = json.load(open(sys.argv[1]))
tree = json.load(open(sys.argv[2]))
show_all = "--all" in sys.argv
wc = {row["id"]: row["rect"] for row in tree["rows"]}
keys = ["x", "y", "width", "height"]
n = bad = 0
for id, p in pen.items():
    w = wc.get(id)
    if w is None:
        print("%-8s missing in woodcase" % id)
        continue
    n += 1
    diff = max(abs(p[k] - w[k]) for k in keys)
    if diff > 0.01 or show_all:
        bad += diff > 0.01
        print("%-8s pen %8.2f %8.2f %7.2f %7.2f | wc %8.2f %8.2f %7.2f %7.2f%s" % (
            id, *[p[k] for k in keys], *[w[k] for k in keys],
            "  unturned=%sx%s" % (w["unturnedSize"]["width"], w["unturnedSize"]["height"]) if "unturnedSize" in w else ""))
print("%d rects compared, %d differ by more than 0.01 pt" % (n, bad))
