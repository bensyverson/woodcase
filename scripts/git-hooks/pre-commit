#!/usr/bin/env bash
# pre-commit — formats the staged Swift files and re-stages them, warns on MAE
# regressions (scripts/mae-check, which never blocks), and refuses a stale or
# hand-edited AGENTS.md (`agents check`). It does not run the tests.
#
# Tracked so a fresh clone gets it; enable it once per clone with
#     git config core.hooksPath scripts/git-hooks
#
# Re-staging a file stages all of it, unstaged hunks included — the house rule is to
# commit every change together anyway. Written for the bash 3.2 macOS ships.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r -d '' file; do
    files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')

if [[ ${#files[@]} -gt 0 ]]; then
    swiftformat --quiet "${files[@]}"
    git add -- "${files[@]}"
fi

scripts/mae-check

# `agents check` reads the shared rules from a sibling checkout, which the Claude Code
# sandbox denies; commit with the sandbox off. A clone without the tool skips it.
if command -v agents >/dev/null 2>&1; then
    agents check || exit 1
else
    echo "pre-commit: agents not installed; skipping the AGENTS.md check" >&2
fi
