GRID_ROWS = [("Rent", "Housing", "1 250.00"), ("Groceries", "Food", "86.40"), ("Train pass", "Transit", "54.00")]


@component("grid", 200)
def _grid():
    k = "grid"
    head = frame(
        f"{k}/head",
        [ref(f"{k}/h{i}", "grid-head", {"grid-head/label": {"content": words}})
         for i, words in enumerate(["Item", "Category", "Amount"])],
        alignItems="center", width="fill_container", fill="$paper-sunk",
    )
    rows = []
    for r, cells in enumerate(GRID_ROWS):
        rows.append(ref(
            f"{k}/r{r}", "grid-row", width="fill_container",
            children=[ref(f"{k}/r{r}c{c}", "grid-cell", {"grid-cell/value": {"content": value}})
                      for c, value in enumerate(cells)],
        ))
    return frame(
        k, [head] + rows, name=k, reusable=True, layout="vertical", clip=True, width=420,
        cornerRadius="$radius-lg", fill="$paper-raised", stroke="$hairline", strokeWidth=1, strokeAlignment="inner",
    )


