component("field-pick-filled", 66)(lambda: ref(
    "field-pick-filled", "field-pick", {"field-pick/value": {"content": "Euro", "fill": "$ink"}},
    name="field-pick-filled", reusable=True))


@component("field-search", 40)
def _field_search():
    k = "field-search"
    return frame(
        k,
        [
            icon(f"{k}/lens", "search", 15, "$ink-soft"),
            text(f"{k}/value", "Find a payee", 13, "normal", "$ink-soft", textGrowth="fixed-width",
                 width="fill_container"),
            # A nested instance: the variants below override *through* it.
            ref(f"{k}/clear", "glyph-action-quiet-md", padding=2),
        ],
        name=k, reusable=True, alignItems="center", gap=8, cornerRadius="$radius-pill", padding=[4, 6, 4, 12],
        fill="$paper-sunk", width=260,
    )


component("field-search-empty", 40)(lambda: ref(
    "field-search-empty", "field-search", {"field-search/clear": {"enabled": False}},
    name="field-search-empty", reusable=True))
component("field-search-active", 40)(lambda: ref(
    "field-search-active", "field-search",
    {
        "field-search/value": {"content": "Corner bakery", "fill": "$ink"},
        # Slash path across the nested glyph-action instance.
        ("field-search/clear", "action-quiet-md/mark"): {"icon": "circle-x", "fill": "$ink-soft"},
    },
    name="field-search-active", reusable=True, stroke="$focus", strokeWidth=2, strokeAlignment="outer"))


# --- toggle: switch, check, radio -------------------------------------------


