#!/usr/bin/env python3
"""gen-kit-fixture — write Tests/WoodcaseTests/Fixtures/kit.lib.pen, an original
component library, from this script alone.

The library exists so the import pipeline has a library-scale fixture that owes
nothing to any bundled design kit: every id, name, token, theme axis, measurement
and string below is written here, and the output is a pure function of this file.
Node ids are derived from a stable key per node (`<component>/<part>`) by hashing,
so they are compact 5-character alphanumerics, never UUIDs, and never change
unless a key does.

What the library is built to exercise (`--report` prints each count):

- scale: 80+ reusable components in 16 families;
- three theme axes (`scheme` x `tint` x `contrast`, 2 x 4 x 2), with colour, number
  and chained (`$accent`) variables that vary along them;
- ref chains: a reusable component that is itself a ref, two deep
  (`glyph-action-outline-lg` -> `action-outline-lg` -> `action-solid-lg`);
- slash-path descendant overrides that cross a nested instance
  (`field-search-active` reaches `<clear>/<mark>` inside a placed `glyph-action`);
- per-side strokes (`row-divided`, `grid-row`, `rail`, `side-rail`);
- disabled children kept out of layout (every `glyph-action` disables the caption
  of the action it wraps; disabled fills on field labels);
- shadows, a background blur and a layer blur; lucide icons; slots;
- one large top-level frame that is not a ref (`kit component sheet`), the
  `woodcase shot` benchmark target.

Usage:
    scripts/gen-kit-fixture                 write the library in place
    scripts/gen-kit-fixture --check         exit 1 if the file on disk differs
    scripts/gen-kit-fixture --report        print the coverage counts
    scripts/gen-kit-fixture --sync-host F   copy the library's `variables` and
                                            `themes` into host document F, which
                                            keeps its own copy of the tokens
    scripts/gen-kit-fixture --ids K [K...]  print the id for each node key

Standard library only; runs sandboxed.
"""

import hashlib
import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "Tests", "WoodcaseTests", "Fixtures", "kit.lib.pen")

ALPHABET = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
FONT = "Inter"

# ---------------------------------------------------------------------------
# Ids
# ---------------------------------------------------------------------------

_ids = {}
_taken = {}


def kid(key):
    """The node id for `key`: five characters from a SHA-256 of the key, the
    first always a letter. A collision rehashes with a counter, so the id of
    every key is fixed by the order keys are first asked for."""
    if key in _ids:
        return _ids[key]
    salt = 0
    while True:
        digest = hashlib.sha256(f"woodcase-kit:{key}:{salt}".encode()).digest()
        chars = [ALPHABET[digest[0] % 52]] + [ALPHABET[b % 62] for b in digest[1:5]]
        candidate = "".join(chars)
        if candidate not in _taken:
            _taken[candidate] = key
            _ids[key] = candidate
            return candidate
        salt += 1


# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------

SCHEMES = ["day", "night"]
TINTS = ["slate", "sand", "moss", "clay"]
CONTRASTS = ["normal", "high"]

# name -> {scheme: base, (scheme, tint): value, (scheme, "high"): value}
COLOR_TOKENS = {
    "paper": {
        "day": "#f6f5f2", ("day", "sand"): "#f7f2e9", ("day", "moss"): "#f2f4ee", ("day", "clay"): "#f7f0ec",
        "night": "#121418", ("night", "sand"): "#16130e", ("night", "moss"): "#0f1410", ("night", "clay"): "#161010",
    },
    "paper-raised": {
        "day": "#ffffff",
        "night": "#1b1e24", ("night", "sand"): "#201c16", ("night", "moss"): "#171d18", ("night", "clay"): "#201818",
    },
    "paper-sunk": {
        "day": "#eceae5", ("day", "sand"): "#eee6d8", ("day", "moss"): "#e5e9df", ("day", "clay"): "#efe3dc",
        "night": "#23272e", ("night", "sand"): "#2a251d", ("night", "moss"): "#1f2720", ("night", "clay"): "#2b2020",
    },
    "ink": {"day": "#1d1f23", "night": "#eef0f2", ("day", "high"): "#08090b", ("night", "high"): "#ffffff"},
    "ink-soft": {"day": "#6b6f78", "night": "#9aa0aa", ("day", "high"): "#45484f", ("night", "high"): "#c4c8cf"},
    "hairline": {"day": "#dddad3", "night": "#ffffff1f", ("day", "high"): "#9c988f", ("night", "high"): "#ffffff52"},
    "field": {"day": "#cfccc4", "night": "#ffffff29", ("day", "high"): "#8a867d", ("night", "high"): "#ffffff66"},
    "accent": {
        "day": "#3d5a80", ("day", "sand"): "#b7791f", ("day", "moss"): "#3f7d4e", ("day", "clay"): "#b5543c",
        "night": "#8fb0dc", ("night", "sand"): "#e0b062", ("night", "moss"): "#7cc48f", ("night", "clay"): "#e38b72",
    },
    "on-accent": {"day": "#ffffff", "night": "#111315"},
    "accent-wash": {
        "day": "#e3e9f2", ("day", "sand"): "#f5e8cf", ("day", "moss"): "#e1eedf", ("day", "clay"): "#f6e1da",
        "night": "#243247", ("night", "sand"): "#3a2e17", ("night", "moss"): "#1f3325", ("night", "clay"): "#3b231c",
    },
    "on-accent-wash": {
        "day": "#22354f", ("day", "sand"): "#6b440c", ("day", "moss"): "#214a2c", ("day", "clay"): "#6e2a19",
        "night": "#d7e4f5", ("night", "sand"): "#f3dcae", ("night", "moss"): "#cdeccf", ("night", "clay"): "#f6d0c4",
    },
    "danger": {"day": "#c2352b", "night": "#f0776b"},
    "on-danger": {"day": "#ffffff", "night": "#1a0e0c"},
    "success": {"day": "#2f8a4c", "night": "#6fd08c"},
}

SIMPLE_TOKENS = {
    # A chained variable: resolves through another token, per theme.
    "focus": ("color", "$accent"),
    "scrim": ("color", "#0b0c0e8c"),
    "radius-sm": ("number", 3),
    "radius-md": ("number", 7),
    "radius-lg": ("number", 12),
    "radius-pill": ("number", 999),
    "space-xs": ("number", 4),
    "space-sm": ("number", 8),
    "space-md": ("number", 12),
    "space-lg": ("number", 18),
}

# A number token that varies along the third axis.
STROKE_WEIGHT = {"normal": 1, "high": 2}


def themed_color(spec):
    """Expands one colour token into Pen's themed-value list. Order matters: the
    last matching entry wins, so single-axis entries come before the pairs that
    refine them, and contrast entries come last."""
    entries = [{"value": spec["day"]}]
    for tint in TINTS[1:]:
        if ("day", tint) in spec:
            entries.append({"theme": {"tint": tint}, "value": spec[("day", tint)]})
    if spec.get("night") and spec["night"] != spec["day"]:
        entries.append({"theme": {"scheme": "night"}, "value": spec["night"]})
    for tint in TINTS[1:]:
        if ("night", tint) in spec:
            entries.append({"theme": {"scheme": "night", "tint": tint}, "value": spec[("night", tint)]})
        elif ("day", tint) in spec and spec.get("night") != spec["day"]:
            # A tint refined for day only: night keeps the plain night value.
            entries.append({"theme": {"scheme": "night", "tint": tint}, "value": spec["night"]})
    if ("day", "high") in spec:
        entries.append({"theme": {"contrast": "high"}, "value": spec[("day", "high")]})
    if ("night", "high") in spec:
        entries.append({"theme": {"contrast": "high", "scheme": "night"}, "value": spec[("night", "high")]})
    return {"type": "color", "value": entries}


def variables():
    result = {name: themed_color(spec) for name, spec in COLOR_TOKENS.items()}
    for name, (kind, value) in SIMPLE_TOKENS.items():
        result[name] = {"type": kind, "value": value}
    result["stroke-weight"] = {
        "type": "number",
        "value": [{"value": STROKE_WEIGHT["normal"]}, {"theme": {"contrast": "high"}, "value": STROKE_WEIGHT["high"]}],
    }
    return result


def themes():
    return {"contrast": CONTRASTS, "scheme": SCHEMES, "tint": TINTS}


# ---------------------------------------------------------------------------
# Node builders. `key` is the stable id key; every builder returns a dict.
# ---------------------------------------------------------------------------


def clean(node):
    return {k: v for k, v in node.items() if v is not None}


def text(key, content, size=13, weight="500", fill="$ink", **kw):
    name = kw.pop("name", key.rsplit("/", 1)[-1])
    return clean({
        "type": "text", "id": kid(key), "name": name, "content": content, "fill": fill,
        "fontFamily": FONT, "fontSize": size, "fontWeight": weight, **kw,
    })


def icon(key, glyph, size=16, fill="$ink", **kw):
    name = kw.pop("name", key.rsplit("/", 1)[-1])
    return clean({
        "type": "icon", "id": kid(key), "name": name, "icon": glyph, "library": "lucide",
        "width": size, "height": size, "fill": fill, **kw,
    })


def frame(key, children=None, **kw):
    name = kw.pop("name", key.rsplit("/", 1)[-1])
    node = {"type": "frame", "id": kid(key), "name": name, **kw}
    if children:
        node["children"] = children
    return clean(node)


def ref(key, target, descendants=None, **kw):
    """A ref to the component keyed `target`. `descendants` maps node keys (or
    lists of keys, for a slash path through nested instances) to overrides."""
    name = kw.pop("name", None)
    node = {"type": "ref", "id": kid(key), "ref": kid(target), **kw}
    if name is not None:
        node["name"] = name
    if descendants:
        node["descendants"] = {path(k): v for k, v in descendants.items()}
    return clean(node)


def path(keys):
    if isinstance(keys, str):
        return kid(keys)
    return "/".join(kid(k) for k in keys)


def soft_shadow(y=2, blur=6, alpha="14"):
    return {"type": "shadow", "shadowType": "outer", "offset": {"x": 0, "y": y}, "blur": blur, "color": f"#101216{alpha}"}


# ---------------------------------------------------------------------------
# Components, by family. Each entry: (key, height estimate, builder()).
# ---------------------------------------------------------------------------

COMPONENTS = []


def component(key, height):
    def register(build):
        COMPONENTS.append((key, height, build))
        return build
    return register


# --- action: buttons ---------------------------------------------------------

ACTION_TONES = {
    # tone: (fill, ink, stroke, effect)
    "solid": ("$accent", "$on-accent", None, None),
    "soft": ("$accent-wash", "$on-accent-wash", None, None),
    "outline": ("$paper-raised", "$ink", "$hairline", soft_shadow(1, 3, "12")),
    "quiet": (None, "$ink", None, None),
    "danger": ("$danger", "$on-danger", None, None),
}
ACTION_SIZES = {
    # size: (padding, glyph box, glyph, caption size, caption)
    "md": ([9, 15], 18, 14, 13, "Continue"),
    "lg": ([11, 22], 22, 22, 15, "Get started"),
}


def action_frame(tone, size):
    fill, ink, stroke, effect = ACTION_TONES[tone]
    pad, box, glyph, caption, words = ACTION_SIZES[size]
    k = f"action-{tone}-{size}"
    offset = (box - glyph) / 2
    offset = int(offset) if offset == int(offset) else offset
    return frame(
        k,
        [
            frame(f"{k}/glyph", [icon(f"{k}/mark", "arrow-right", glyph, ink, x=offset, y=offset)],
                  layout="none", width=box, height=box),
            text(f"{k}/caption", words, caption, "600", ink, textAlign="center", textAlignVertical="middle"),
        ],
        name=k, reusable=True, alignItems="center", justifyContent="center", gap=7,
        cornerRadius="$radius-md", padding=pad, fill=fill, stroke=stroke,
        strokeWidth=("$stroke-weight" if stroke else None), strokeAlignment=("inner" if stroke else None),
        effect=effect,
    )


for _size in ACTION_SIZES:
    for _tone in ACTION_TONES:
        _key = f"action-{_tone}-{_size}"
        if _size == "lg" and _tone != "solid":
            # Large tones are refs to the solid one: the first link of the chain.
            def _build(tone=_tone, key=_key):
                fill, ink, stroke, effect = ACTION_TONES[tone]
                base = "action-solid-lg"
                return ref(
                    key, base,
                    {f"{base}/caption": {"fill": ink}, f"{base}/mark": {"fill": ink}},
                    name=key, reusable=True, fill=(fill if fill else []), stroke=stroke,
                    strokeWidth=("$stroke-weight" if stroke else None),
                    strokeAlignment=("inner" if stroke else None),
                    effect=(effect if effect else None),
                )
        else:
            def _build(tone=_tone, size=_size):
                return action_frame(tone, size)
        component(_key, 48 if _size == "lg" else 40)(_build)


# --- glyph-action: icon-only buttons, every one a ref with its caption off ----

for _size in ACTION_SIZES:
    for _tone in ACTION_TONES:
        _key = f"glyph-action-{_tone}-{_size}"

        def _build(tone=_tone, size=_size, key=_key):
            target = f"action-{tone}-{size}"
            caption_owner = f"action-{tone}-{size}" if size == "md" else "action-solid-lg"
            return ref(
                key, target, {f"{caption_owner}/caption": {"enabled": False}},
                name=key, reusable=True, padding=(9 if size == "md" else 10),
            )
        component(_key, 48 if _size == "lg" else 40)(_build)


# --- tag: small labels -------------------------------------------------------


@component("tag-solid", 24)
def _tag_solid():
    return frame(
        "tag-solid", [text("tag-solid/label", "New", 11, "600", "$on-accent", textAlign="center")],
        name="tag-solid", reusable=True, alignItems="center", justifyContent="center",
        cornerRadius="$radius-pill", padding=[3, 9], fill="$accent",
    )


for _key, _fill, _ink, _stroke in [
    ("tag-soft", "$accent-wash", "$on-accent-wash", None),
    ("tag-outline", [], "$ink", "$hairline"),
    ("tag-danger", "$danger", "$on-danger", None),
    ("tag-success", "$success", "$on-accent", None),
]:
    def _build(key=_key, fill=_fill, ink=_ink, stroke=_stroke):
        return ref(
            key, "tag-solid", {"tag-solid/label": {"fill": ink}}, name=key, reusable=True, fill=fill,
            stroke=stroke, strokeWidth=(1 if stroke else None), strokeAlignment=("inner" if stroke else None),
        )
    component(_key, 24)(_build)


# --- portrait: avatars -------------------------------------------------------


@component("portrait-md", 42)
def _portrait_md():
    return frame(
        "portrait-md", [text("portrait-md/initials", "MK", 14, "600", "$ink", textAlign="center")],
        name="portrait-md", reusable=True, layout="vertical", alignItems="center", justifyContent="center",
        width=40, height=40, cornerRadius="$radius-pill", fill="$paper-sunk",
    )


for _key, _side, _size in [("portrait-sm", 30, 11), ("portrait-lg", 56, 19)]:
    def _build(key=_key, side=_side, size=_size):
        return ref(key, "portrait-md", {"portrait-md/initials": {"fontSize": size}},
                   name=key, reusable=True, width=side, height=side)
    component(_key, _side + 2)(_build)


@component("portrait-stack", 42)
def _portrait_stack():
    k = "portrait-stack"
    people = [("RB", "$accent-wash"), ("TO", "$paper-sunk"), ("JL", "$accent")]
    return frame(
        k,
        [
            ref(f"{k}/p{i}", "portrait-md", {"portrait-md/initials": {"content": who}}, fill=fill,
                stroke="$paper", strokeWidth=2, strokeAlignment="outer")
            for i, (who, fill) in enumerate(people)
        ],
        name=k, reusable=True, alignItems="center", gap=-10,
    )


# --- field: inputs -----------------------------------------------------------


def field_label(k, words="Account name"):
    return frame(
        f"{k}/label-row",
        [text(f"{k}/label", words, 13, "500", "$ink", textGrowth="fixed-width", width="fill_container")],
        fill={"type": "color", "color": "$paper-sunk", "enabled": False}, alignItems="center",
        width="fill_container",
    )


@component("field-text", 86)
def _field_text():
    k = "field-text"
    return frame(
        k,
        [
            field_label(k),
            frame(f"{k}/box", [text(f"{k}/value", "e.g. Household", 13, "normal", "$ink-soft")],
                  alignItems="center", cornerRadius="$radius-md", padding=[9, 11], fill="$paper-raised",
                  stroke="$field", strokeWidth="$stroke-weight", strokeAlignment="inner", width="fill_container"),
            text(f"{k}/hint", "Shown on statements.", 12, "normal", "$ink-soft"),
        ],
        name=k, reusable=True, layout="vertical", gap=5, width=260,
    )


component("field-text-filled", 86)(lambda: ref(
    "field-text-filled", "field-text", {"field-text/value": {"content": "Household", "fill": "$ink"}},
    name="field-text-filled", reusable=True))
component("field-text-error", 86)(lambda: ref(
    "field-text-error", "field-text",
    {"field-text/box": {"stroke": "$danger"}, "field-text/hint": {"content": "That name is taken.", "fill": "$danger"}},
    name="field-text-error", reusable=True))
component("field-bare", 44)(lambda: ref(
    "field-bare", "field-text", {"field-text/label-row": {"enabled": False}, "field-text/hint": {"enabled": False}},
    name="field-bare", reusable=True))


@component("field-area", 128)
