# ---------------------------------------------------------------------------
# The sheet: every component, stacked in columns, inside one large frame.
# ---------------------------------------------------------------------------

COLUMN_WIDTH = 460
COLUMN_HEIGHT = 1400
MARGIN = 60


def build():
    placed = []
    x, y = MARGIN, MARGIN
    tallest_column = 0
    for key, height, make in COMPONENTS:
        if y + height > COLUMN_HEIGHT:
            x += COLUMN_WIDTH
            y = MARGIN
        node = make()
        node["x"], node["y"] = x, y
        placed.append(node)
        y += height + 28
        tallest_column = max(tallest_column, y)
    sheet = {
        "type": "frame", "id": kid("sheet-root"), "name": "kit component sheet", "x": 0, "y": 0,
        "width": x + COLUMN_WIDTH, "height": max(tallest_column, COLUMN_HEIGHT) + MARGIN, "layout": "none",
        "clip": True, "fill": "$paper",
        "children": placed,
    }
    return {"version": "2.17", "themes": themes(), "variables": variables(), "children": [sheet]}


def render(document):
    return json.dumps(document, indent=2, sort_keys=True, ensure_ascii=False) + "\n"


# ---------------------------------------------------------------------------
# Report: the coverage the library promises, counted off the output.
# ---------------------------------------------------------------------------


def report(document):
    nodes = []

    def walk(node, depth):
        nodes.append((node, depth))
        for child in node.get("children", []) or []:
            walk(child, depth + 1)

    for child in document["children"]:
        walk(child, 0)
    reusable = {n["id"]: n for n, _ in nodes if n.get("reusable")}
    chains = [n for n in reusable.values() if n["type"] == "ref" and reusable.get(n["ref"], {}).get("type") == "ref"]
    slash = [k for n, _ in nodes if n["type"] == "ref" for k in (n.get("descendants") or {}) if "/" in k]
    per_side = [n["name"] for n, _ in nodes if isinstance(n.get("strokeWidth"), dict)]
    disabled = [k for n, _ in nodes if n["type"] == "ref"
                for k, v in (n.get("descendants") or {}).items() if v.get("enabled") is False]
    families = sorted({n["name"].split("-")[0] for n in reusable.values()})
    print(f"reusable components   {len(reusable)}")
    print(f"families              {len(families)}  ({', '.join(families)})")
    print(f"nodes                 {len(nodes)}")
    print(f"variables             {len(document['variables'])}")
    print(f"theme axes            " + " x ".join(f"{a}({len(v)})" for a, v in document["themes"].items()))
    print(f"ref chains            {len(chains)}  ({', '.join(sorted(n['name'] for n in chains))})")
    print(f"slash-path overrides  {len(slash)}")
    print(f"per-side strokes      {len(per_side)}  ({', '.join(sorted(set(per_side)))})")
    print(f"disabled children     {len(disabled)}")


def main(argv):
    document = build()
    output = render(document)
    if "--ids" in argv:
        for key in argv[argv.index("--ids") + 1:]:
            print(f"{key}\t{_ids.get(key, '?')}")
        return 0
    if "--report" in argv:
        report(document)
        return 0
    if "--check" in argv:
        with open(OUT, encoding="utf-8") as f:
            same = f.read() == output
        print("kit.lib.pen is current" if same else "kit.lib.pen differs from the generator; re-run it")
        return 0 if same else 1
    if "--sync-host" in argv:
        host_path = argv[argv.index("--sync-host") + 1]
        with open(host_path, encoding="utf-8") as f:
            host = json.load(f)
        host["variables"] = document["variables"]
        host["themes"] = document["themes"]
        with open(host_path, "w", encoding="utf-8") as f:
            f.write(render(host))
        print(f"synced variables and themes into {host_path}")
        return 0
    with open(OUT, "w", encoding="utf-8") as f:
        f.write(output)
    print(f"wrote {os.path.relpath(OUT, ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
