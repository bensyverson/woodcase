@component("row-divided", 46)
def _row_divided():
    k = "row-divided"
    return frame(
        k,
        [text(f"{k}/label", "Standing orders", 14, "normal", "$ink", textGrowth="fixed-width", width="fill_container"),
         text(f"{k}/value", "3 active", 13, "normal", "$ink-soft")],
        name=k, reusable=True, alignItems="center", gap=12, padding=[13, 2], width=280,
        # Bottom edge only: the per-side stroke case.
        stroke="$hairline", strokeWidth={"bottom": 1}, strokeAlignment="inner",
