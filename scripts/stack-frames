#!/usr/bin/env python3
"""
stack-frames — how much stack each function in a built binary reserves per call.

A debug build gives every value temporary its own stack slot, so a recursive walk over
`PenNode`s can reserve kilobytes per level and overflow a 512 KiB task stack a few
dozen levels deep (project/2026-09-26-debug-stack-depth.md). This reads the prologue of
every function whose (demangled) name matches a pattern and prints the bytes it
subtracts from `sp`, largest first.

Usage:
  scripts/stack-frames <binary> <regex> [--top N]

Example:
  scripts/stack-frames .build/debug/woodcase 'PenRefExpander|PenNodePatcher|PenNode\\.init' --top 20

Needs `nm`, `swift demangle` and `llvm-objdump` (all via `xcrun`); run it with the
Bash sandbox disabled, since the toolchain lives outside it. arm64 only.
"""

import re
import subprocess
import sys


def symbols(binary):
    """(address, mangled) for every text symbol, sorted by address."""
    out = subprocess.run(["xcrun", "nm", "-n", "--defined-only", binary],
                         capture_output=True, text=True, check=True).stdout
    found = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 3 and parts[1] in ("T", "t"):
            found.append((int(parts[0], 16), parts[2]))
    return found


def demangle(names):
    """Demangled names, in order."""
    out = subprocess.run(["xcrun", "swift", "demangle", "--simplified"],
                         input="\n".join(names), capture_output=True, text=True, check=True).stdout
    return out.splitlines()


def frame_size(binary, start, stop):
    """Bytes the prologue subtracts from sp, or 0."""
    out = subprocess.run(
        ["xcrun", "llvm-objdump", "-d", "--no-show-raw-insn",
         f"--start-address={start:#x}", f"--stop-address={min(stop, start + 96):#x}", binary],
        capture_output=True, text=True).stdout
    total = 0
    x9 = 0
    for line in out.splitlines():
        if m := re.search(r"\bmov\s+x9, #(0x[0-9a-f]+|\d+)", line):
            x9 = int(m.group(1), 0)
        elif m := re.search(r"\bmovk\s+x9, #(0x[0-9a-f]+|\d+), lsl #(\d+)", line):
            x9 |= int(m.group(1), 0) << int(m.group(2))
        elif "__chkstk_darwin" in line:
            total += x9 * 16
        elif m := re.search(r"\bsub\s+sp, sp, #(0x[0-9a-f]+|\d+)(, lsl #12)?", line):
            total += int(m.group(1), 0) << (12 if m.group(2) else 0)
        elif re.search(r"\bstp\s+x29, x30, \[sp, #-(\d+)\]!", line):
            total += int(re.search(r"#-(\d+)", line).group(1))
    return total


def main():
    if len(sys.argv) < 3:
        print(__doc__)
        sys.exit(2)
    binary, pattern = sys.argv[1], re.compile(sys.argv[2])
    top = int(sys.argv[sys.argv.index("--top") + 1]) if "--top" in sys.argv else 40
    syms = symbols(binary)
    names = demangle([s for _, s in syms])
    rows = []
    for index, ((address, _), name) in enumerate(zip(syms, names)):
        if not pattern.search(name):
            continue
        stop = syms[index + 1][0] if index + 1 < len(syms) else address + 96
        rows.append((frame_size(binary, address, stop), name))
    for size, name in sorted(rows, reverse=True)[:top]:
        print(f"{size:8d}  {name[:150]}")


if __name__ == "__main__":
    main()
