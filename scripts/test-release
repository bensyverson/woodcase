#!/usr/bin/env bash
# test-release — regression test for scripts/release.
#
# Builds a throwaway Woodcase repo and Homebrew tap under $TMPDIR, each pushing to a local
# bare remote, and puts stub `swift`, `swiftformat`, `curl` and `brew` first on PATH, so
# no real build, download or Homebrew call happens. Then checks every state a release can
# be found in: nothing done, bumped and pushed but untagged, tagged but the formula stale,
# fully released — plus the refusals (bad version, dirty tree, conflicting tag, failing
# tests) and a dry run that touches nothing. Exits non-zero on the first failed assertion.
#
# Runs sandboxed: it needs git, and nothing from the network.
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
release_src="${script_dir}/release"

work="$(mktemp -d "${TMPDIR:-/tmp}/release-test.XXXXXX")"
trap 'rm -rf "$work"' EXIT

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 XDG_CONFIG_HOME="${work}/xdg"
export GIT_AUTHOR_NAME=Test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=Test GIT_COMMITTER_EMAIL=test@example.com

version_file="Sources/WoodcaseCommandCore/Verbs/WoodcaseVersion.swift"

fail() {
    echo "FAIL [${case_name:-setup}]: $1" >&2
    [[ -f "${work}/out" ]] && sed 's/^/    | /' "${work}/out" >&2
    exit 1
}

# --- Stubs ------------------------------------------------------------------------------

stubs="${work}/stubs"
mkdir -p "$stubs"
cat >"${stubs}/swift" <<'EOF'
#!/usr/bin/env bash
echo "swift $*" >>"$STUB_LOG"
exit "${STUB_SWIFT_EXIT:-0}"
EOF
cat >"${stubs}/swiftformat" <<'EOF'
#!/usr/bin/env bash
echo "swiftformat $*" >>"$STUB_LOG"
EOF
# curl writes "tarball of <url>" to its -o file, so the sha is a function of the URL.
cat >"${stubs}/curl" <<'EOF'
#!/usr/bin/env bash
echo "curl $*" >>"$STUB_LOG"
out="" url=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) out="$2"; shift 2 ;;
        -*) shift ;;
        *) url="$1"; shift ;;
    esac
done
printf 'tarball of %s' "$url" >"$out"
EOF
cat >"${stubs}/brew" <<'EOF'
#!/usr/bin/env bash
echo "brew $*" >>"$STUB_LOG"
case "$1" in
    --repository) echo "$STUB_BREW_TAP" ;;
    list) [[ -n "${STUB_BREW_INSTALLED:-}" ]] ;;
esac
EOF
chmod +x "${stubs}"/*
export PATH="${stubs}:${PATH}"

sha_of() { printf 'tarball of %s' "$1" | shasum -a 256 | cut -d' ' -f1; }
tarball() { echo "https://github.com/bensyverson/woodcase/archive/refs/tags/v$1.tar.gz"; }

# --- Fixture ----------------------------------------------------------------------------

# setup <version in source> <tag the source?>: a fresh repo, tap and remotes, both
# released at 0.1.0; when the source says more, that commit is pushed untagged.
setup() {
    rm -rf "${work}/case"
    local root="${work}/case"
    mkdir -p "$root"
    git init -q --bare -b main "${root}/woodcase.git"
    git init -q --bare -b main "${root}/tap.git"

    wc="${root}/woodcase"
    git init -q -b main "$wc"
    mkdir -p "${wc}/scripts" "${wc}/$(dirname "$version_file")"
    cp "$release_src" "${wc}/scripts/release"
    write_version 0.1.0
    git -C "$wc" add -A
    git -C "$wc" commit -q -m "Initial"
    git -C "$wc" tag -a v0.1.0 -m "Woodcase 0.1.0"
    git -C "$wc" remote add origin "${root}/woodcase.git"
    git -C "$wc" push -q origin main v0.1.0
    if [[ "$1" != 0.1.0 ]]; then
        write_version "$1"
        git -C "$wc" commit -q -am "Bumps version"
        git -C "$wc" push -q origin main
    fi

    tap="${root}/homebrew-tap"
    git init -q -b main "$tap"
    mkdir -p "${tap}/Formula"
    write_formula 0.1.0
    git -C "$tap" add -A
    git -C "$tap" commit -q -m "Adds the woodcase formula"
    git -C "$tap" remote add origin "${root}/tap.git"
    git -C "$tap" push -q origin main

    export STUB_BREW_TAP="${root}/brew-tap"
    git clone -q "${root}/tap.git" "$STUB_BREW_TAP"
    export STUB_LOG="${root}/stub.log"
    : >"$STUB_LOG"
    unset STUB_SWIFT_EXIT STUB_BREW_INSTALLED
}

write_version() {
    cat >"${wc}/${version_file}" <<EOF
enum WoodcaseVersion {
    /// The package's own version.
    static let current = "$1"
}
EOF
}

write_formula() {
    cat >"${tap}/Formula/woodcase.rb" <<EOF
class Woodcase < Formula
  desc "Test formula"
  url "$(tarball "$1")"
  sha256 "$(sha_of "$(tarball "$1")")"
  license "MIT"
end
EOF
}

# release <expected exit> <args…>
release() {
    local expected="$1" status=0
    shift
    "${wc}/scripts/release" "$@" >"${work}/out" 2>&1 </dev/null || status=$?
    [[ "$status" == "$expected" ]] || fail "exit ${status}, expected ${expected}"
}

assert_out() { grep -qF -- "$1" "${work}/out" || fail "output lacks: $1"; }
assert_log() { grep -qF -- "$1" "$STUB_LOG" || fail "no stub call: $1 (log: $(tr '\n' ';' <"$STUB_LOG"))"; }
refute_log() { ! grep -qF -- "$1" "$STUB_LOG" || fail "unexpected stub call: $1"; }
source_version() { sed -n 's/.*static let current = "\(.*\)".*/\1/p' "${wc}/${version_file}"; }
remote_tag() { git -C "${work}/case/woodcase.git" rev-parse -q --verify "refs/tags/v$1^{commit}" || true; }
remote_formula() { git -C "${work}/case/tap.git" show main:Formula/woodcase.rb; }

assert_released() {
    local v="$1"
    [[ -n "$(remote_tag "$v")" ]] || fail "v${v} not pushed"
    [[ "$(git -C "${work}/case/woodcase.git" cat-file -t "v${v}")" == tag ]] || fail "v${v} is not annotated"
    [[ "$(git -C "${work}/case/woodcase.git" show "v${v}:${version_file}")" == *"\"${v}\""* ]] ||
        fail "v${v} does not carry version ${v}"
    remote_formula | grep -qF "url \"$(tarball "$v")\"" || fail "formula url not at ${v}"
    remote_formula | grep -qF "sha256 \"$(sha_of "$(tarball "$v")")\"" || fail "formula sha256 wrong"
    [[ -z "$(git -C "$wc" status --porcelain)" ]] || fail "repo left dirty"
    [[ -z "$(git -C "$tap" status --porcelain)" ]] || fail "tap left dirty"
    assert_log "brew install bensyverson/tap/woodcase"
    # The formula has no bottles, so Homebrew builds from source anyway; the flag only
    # adds a "building from source is not supported" warning.
    refute_log "--build-from-source"
    assert_log "brew test bensyverson/tap/woodcase"
    assert_log "brew audit --strict bensyverson/tap/woodcase"
    git -C "$STUB_BREW_TAP" log -1 --format=%s | grep -qF "$v" || fail "brew's tap clone not updated"
}

# --- Cases ------------------------------------------------------------------------------

case_name="usage: malformed version"
setup 0.1.0
release 2 1.2
assert_out "X.Y.Z"
release 2 --bogus
release 2 0.1.1 0.1.2

case_name="usage: version older than the source"
setup 0.1.1
release 2 0.1.0
assert_out "0.1.1"

case_name="nothing new: verifies and says how to release"
setup 0.1.0
release 0
assert_out "already released"
assert_out "scripts/release <version>"
assert_log "brew test bensyverson/tap/woodcase"

case_name="dirty tree"
setup 0.1.0
echo "// edit" >>"${wc}/${version_file}"
release 3 0.1.1
assert_out "uncommitted"
[[ -z "$(remote_tag 0.1.1)" ]] || fail "tagged despite a dirty tree"

case_name="dirty tap"
setup 0.1.0
echo "# edit" >>"${tap}/Formula/woodcase.rb"
release 3 0.1.1
assert_out "uncommitted"

case_name="behind origin"
setup 0.1.0
git clone -q "${work}/case/woodcase.git" "${work}/case/other"
git -C "${work}/case/other" commit -q --allow-empty -m "Elsewhere"
git -C "${work}/case/other" push -q origin main
release 3 0.1.1
assert_out "behind"

case_name="dry run"
setup 0.1.0
before="$(git -C "$wc" rev-parse HEAD)"
release 0 0.1.1 --dry-run
assert_out "would"
[[ "$(git -C "$wc" rev-parse HEAD)" == "$before" ]] || fail "dry run committed"
[[ "$(source_version)" == 0.1.0 ]] || fail "dry run edited the version"
[[ -z "$(remote_tag 0.1.1)" ]] || fail "dry run tagged"
remote_formula | grep -qF "v0.1.0.tar.gz" || fail "dry run moved the formula"
refute_log "swift test"
refute_log "brew install"

case_name="full release from scratch"
setup 0.1.0
release 0 0.1.1
[[ "$(source_version)" == 0.1.1 ]] || fail "version not bumped"
[[ "$(git -C "${work}/case/woodcase.git" rev-parse main)" == "$(git -C "$wc" rev-parse HEAD)" ]] ||
    fail "bump not pushed"
assert_log "swiftformat . --lint"
assert_log "swift test --quiet"
assert_released 0.1.1

case_name="resume: bumped and pushed, not tagged"
setup 0.1.1
head="$(git -C "$wc" rev-parse HEAD)"
release 0
[[ "$(git -C "$wc" rev-parse HEAD)" == "$head" ]] || fail "made a commit it did not need"
[[ "$(remote_tag 0.1.1)" == "$head" ]] || fail "tag not on the bump commit"
assert_log "swift test --quiet"
assert_released 0.1.1

case_name="resume: explicit version equal to the source"
setup 0.1.1
release 0 0.1.1
assert_released 0.1.1

case_name="resume: tagged, formula stale"
setup 0.1.1
git -C "$wc" tag -a v0.1.1 -m "Woodcase 0.1.1"
git -C "$wc" push -q origin v0.1.1
git -C "$wc" commit -q --allow-empty -m "Later work"
git -C "$wc" push -q origin main
release 0
refute_log "swift test"
assert_released 0.1.1

case_name="resume: fully released reruns only the Homebrew check"
setup 0.1.0
release 0 0.1.1
: >"$STUB_LOG"
release 0
assert_out "already released"
refute_log "swift test"
refute_log "curl"
assert_log "brew test bensyverson/tap/woodcase"

case_name="conflict: tag exists on another commit"
setup 0.1.0
git -C "$wc" tag -a v0.1.1 -m "Stray" HEAD
git -C "$wc" push -q origin v0.1.1
release 3 0.1.1
assert_out "v0.1.1"
[[ "$(source_version)" == 0.1.0 ]] || fail "bumped despite the conflict"

case_name="failing tests"
setup 0.1.0
export STUB_SWIFT_EXIT=1
release 5 0.1.1
[[ "$(source_version)" == 0.1.0 ]] || fail "bump left behind after failing tests"
[[ -z "$(git -C "$wc" status --porcelain)" ]] || fail "repo left dirty"
[[ -z "$(remote_tag 0.1.1)" ]] || fail "tagged despite failing tests"
refute_log "curl"

case_name="already installed: reinstalls"
setup 0.1.1
export STUB_BREW_INSTALLED=1
release 0
assert_log "brew reinstall bensyverson/tap/woodcase"
refute_log "brew install"
refute_log "--build-from-source"

case_name="--skip-tests and --no-verify"
setup 0.1.1
release 0 --skip-tests --no-verify
refute_log "swift test"
refute_log "brew"
remote_formula | grep -qF "v0.1.1.tar.gz" || fail "formula not moved"

echo "PASS: scripts/release"
