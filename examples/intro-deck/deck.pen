              "name": "Title",
              "type": "frame",
              "width": "fill_container"
            },
            {
              "content": "Code is how agents already work. A script runs as one transaction, so it can check its own edit and refuse it: this one found the new name no longer fit, and nothing was saved.",
              "fill": "#454B57",
              "fontFamily": "Schibsted Grotesk",
              "fontSize": 23,
              "id": "A8Vss",
              "lineHeight": 1.42,
