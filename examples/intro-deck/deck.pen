        {
          "children": [
            {
              "content": "Woodcase closes the feedback loop: command, view, iterate.",
              "fill": "#0E1117",
              "fontFamily": "Schibsted Grotesk",
              "fontSize": 56,
              "fontWeight": "500",
              "id": "t5955",
              "letterSpacing": -1.568,
              "lineHeight": 1.06,
              "name": "Title",
              "textGrowth": "fixed-width",
              "type": "text",
              "width": "fill_container"
            },
            {
