{
  "children": [
    {
      "height": 100,
      "id": "uniform-stroke",
      "stroke": "#000000",
      "strokeAlignment": "inner",
      "strokeLinecap": "round",
      "strokeWidth": 2,
      "type": "rectangle",
      "width": 100
    },
    {
      "height": 100,
      "id": "per-side-stroke",
      "stroke": "#0000FF",
      "strokeLinejoin": "bevel",
      "strokeWidth": {
        "bottom": 3,
        "left": 4,
        "right": 2,
        "top": 1
      },
      "type": "rectangle",
      "width": 100
    },
    {
      "height": 100,
      "id": "dashed-stroke",
      "stroke": "#FF0000",
      "strokeAlignment": "outer",
      "strokeLinecap": "square",
      "strokeWidth": 2,
      "type": "rectangle",
      "width": 100
    }
  ],
  "version": "2.17"
}
