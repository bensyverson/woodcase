{
  "version": "2.17",
  "fileToken": "tok-base",
  "fonts": [{ "name": "Inter", "url": "./Inter.ttf" }],
  "themes": { "mode": ["light", "dark"] },
  "variables": {
    "color.primary": { "type": "color", "value": "#3366FF" },
    "space.m": { "type": "number", "value": 16 },
    "legacy": { "type": "string", "value": "old" }
  },
  "children": [
    {
      "id": "Button",
      "name": "Button",
      "type": "frame",
      "reusable": true,
      "width": 120,
      "height": 40,
      "fill": "$color.primary",
      "children": [
        { "id": "ButtonLabel", "name": "Label", "type": "text", "content": "Click", "fill": "#FFFFFF" }
      ]
    },
    {
      "id": "Badge",
      "name": "Badge",
      "type": "frame",
      "reusable": true,
      "x": 0,
      "y": 100,
      "width": 40,
      "height": 20,
      "children": [
        { "id": "BadgeDot", "name": "Dot", "type": "ellipse", "width": 8, "height": 8, "fill": "#FF0000" }
      ]
    },
    {
      "id": "Page",
      "name": "Page",
      "type": "frame",
      "x": 200,
      "y": 0,
      "width": 800,
      "height": 600,
      "layout": "vertical",
      "gap": "$space.m",
      "children": [
        {
          "id": "Header",
          "name": "Header",
          "type": "frame",
          "width": "fill_container",
          "height": 80,
          "children": [
            { "id": "Title", "name": "Title", "type": "text", "content": "Hello", "fontSize": 24 },
            { "id": "Logo", "name": "Logo", "type": "rectangle", "width": 40, "height": 40 }
          ]
        },
        {
          "id": "Body",
          "name": "Body",
          "type": "frame",
          "children": [
            {
              "id": "Card",
              "name": "Card",
              "type": "frame",
              "children": [
                {
                  "id": "CardInner",
                  "name": "Inner",
                  "type": "frame",
                  "children": [{ "id": "CardText", "name": "Copy", "type": "text", "content": "Body copy" }]
                }
              ]
            },
            { "id": "Cta", "name": "Cta", "type": "ref", "ref": "Button", "descendants": { "ButtonLabel": { "content": "Buy" } } },
            { "id": "BadgeUse", "name": "Badge use", "type": "ref", "ref": "Badge" }
          ]
        },
        {
          "id": "Footer",
          "name": "Footer",
          "type": "frame",
          "children": [
            { "id": "Copyright", "name": "Copyright", "type": "text", "content": "© 2026" },
            { "id": "Divider", "name": "Divider", "type": "line", "width": 100, "height": 1 },
            { "id": "SpacerUse", "name": "Spacer use", "type": "ref", "ref": "Spacer" }
          ]
        },
        { "id": "Placeholder", "name": "Placeholder", "type": "rectangle", "width": 10, "height": 10 },
        { "id": "Spacer", "name": "Spacer", "type": "frame", "reusable": true, "width": 10, "height": 10, "children": [] },
        { "id": "EmptyBox", "name": "Empty box", "type": "frame", "width": 10, "height": 10, "children": [] }
      ]
    }
  ]
}
