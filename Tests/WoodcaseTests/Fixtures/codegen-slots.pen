              "fontFamily": "Inter", "fontSize": 15, "fontWeight": "600"},
             {"id": "SlF07", "name": "Badge", "type": "rectangle", "width": 8, "height": 8, "cornerRadius": 4, "fill": "#10B981"}
           ]},
           "SlPf1": {"children": [
             {"id": "SlF08", "name": "Cancel", "type": "text", "content": "Cancel", "fill": "#6B7280",
              "fontFamily": "Inter", "fontSize": 13},
             {"id": "SlF09", "name": "Save", "type": "text", "content": "Save", "fill": "#2563EB",
              "fontFamily": "Inter", "fontSize": 13, "fontWeight": "600"}
           ]}
         }}
      ]
    },
    {
      "id": "SlP05", "name": "Header Panel", "type": "frame", "x": 340, "y": 600,
      "width": 300, "height": "fit_content", "layout": "vertical", "padding": 20, "fill": "#F3F4F6",
      "children": [
        {"id": "SlI05", "type": "ref", "ref": "SlPn1",
         "descendants": {
           "SlPh1": {"children": [
             {"id": "SlF10", "name": "Heading", "type": "text", "content": "Notifications", "fill": "#111827",
