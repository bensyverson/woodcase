import { cn } from "../lib/cn";

interface TextInputProps {
  label?: string;
  placeholder?: string;
  className?: string;
  style?: React.CSSProperties;
}

export function TextInput({
  label = "Label",
  placeholder = "Value",
  className,
  style,
}: TextInputProps) {
  return (
    <div
      className={cn("flex flex-col gap-1.5", className)}
      style={{
        width: 354,
        ...style,
      }}
    >
      <p
        style={{
          color: "var(--text-secondary)",
          fontFamily: "var(--font-primary)",
          fontSize: 12,
          fontWeight: 500,
          lineHeight: "16px",
          fontOpticalSizing: "none",
          whiteSpace: "pre",
          marginTop: -0.5,
          marginBottom: 0.5,
        }}
      >
        {label}
      </p>
      <div
        className="flex"
        style={{
          width: "100%",
          backgroundColor: "var(--bg-warm)",
          borderRadius: 10,
          padding: "var(--spacing-sm)",
          boxShadow: "inset 0 0 0 1px var(--border-default)",
        }}
      >
        <p
          style={{
            color: "var(--text-muted)",
            fontFamily: "var(--font-primary)",
            fontSize: 14,
            fontWeight: "normal",
            lineHeight: "18px",
            fontOpticalSizing: "none",
            whiteSpace: "pre",
            marginTop: -0.25,
            marginBottom: 0.25,
          }}
        >
          {placeholder}
        </p>
      </div>
    </div>
  );
}
