        }
    }

    /// `$ink-soft`.
    var inkSoft: Color {
        switch (contrast, scheme) {
        case (.normal, .day): Color(hex: 0x6B6F78)
        case (.normal, .night): Color(hex: 0x9AA0AA)
        case (.high, .day): Color(hex: 0x45484F)
        case (.high, .night): Color(hex: 0xC4C8CF)
        }
    }

    /// `$on-accent`.
    var onAccent: Color {
        switch scheme {
        case .day: Color(hex: 0xFFFFFF)
        case .night: Color(hex: 0x111315)
        }
    }

    /// `$on-accent-wash`.
    var onAccentWash: Color {
        switch (scheme, tint) {
