    /// `$paper-sunk`.
    var paperSunk: Color {
        switch (scheme, tint) {
        case (.day, .slate): Color(hex: 0xECEAE5)
        case (.day, .sand): Color(hex: 0xEEE6D8)
        case (.day, .moss): Color(hex: 0xE5E9DF)
