import SwiftUI

/// The document's theme: an option on each of its axes, and its variables as they read under them.
///
/// Views read it from the environment (`@Environment(\.penTheme)`); `penTheme(…)` sets it on a subtree.
public struct PenTheme: Hashable, Sendable {
    /// The `contrast` axis.
    public enum Contrast: String, CaseIterable, Hashable, Sendable {
        case normal
        case high
    }

    /// The `scheme` axis.
    public enum Scheme: String, CaseIterable, Hashable, Sendable {
        case day
        case night
    }

    /// The `tint` axis.
    public enum Tint: String, CaseIterable, Hashable, Sendable {
        case slate
        case sand
        case moss
        case clay
    }

    /// The option on the `contrast` axis.
    public var contrast: Contrast
    /// The option on the `scheme` axis.
    public var scheme: Scheme
    /// The option on the `tint` axis.
    public var tint: Tint

    /// A theme; each axis defaults to its first option, as Pen's default theme does.
    public init(contrast: Contrast = .normal, scheme: Scheme = .day, tint: Tint = .slate) {
        self.contrast = contrast
        self.scheme = scheme
        self.tint = tint
    }
}

public extension PenTheme {
    /// `$accent`.
    var accent: Color {
        switch (scheme, tint) {
        case (.day, .slate): Color(hex: 0x3D5A80)
        case (.day, .sand): Color(hex: 0xB7791F)
        case (.day, .moss): Color(hex: 0x3F7D4E)
        case (.day, .clay): Color(hex: 0xB5543C)
        case (.night, .slate): Color(hex: 0x8FB0DC)
        case (.night, .sand): Color(hex: 0xE0B062)
        case (.night, .moss): Color(hex: 0x7CC48F)
        case (.night, .clay): Color(hex: 0xE38B72)
        }
    }

    /// `$accent-wash`.
    var accentWash: Color {
        switch (scheme, tint) {
        case (.day, .slate): Color(hex: 0xE3E9F2)
        case (.day, .sand): Color(hex: 0xF5E8CF)
        case (.day, .moss): Color(hex: 0xE1EEDF)
        case (.day, .clay): Color(hex: 0xF6E1DA)
        case (.night, .slate): Color(hex: 0x243247)
        case (.night, .sand): Color(hex: 0x3A2E17)
        case (.night, .moss): Color(hex: 0x1F3325)
        case (.night, .clay): Color(hex: 0x3B231C)
        }
    }

    /// `$danger`.
    var danger: Color {
        switch scheme {
        case .day: Color(hex: 0xC2352B)
        case .night: Color(hex: 0xF0776B)
        }
    }

    /// `$field`.
    var field: Color {
        switch (contrast, scheme) {
        case (.normal, .day): Color(hex: 0xCFCCC4)
        case (.normal, .night): Color(hex: 0xFFFFFF, opacity: 0.161)
        case (.high, .day): Color(hex: 0x8A867D)
        case (.high, .night): Color(hex: 0xFFFFFF, opacity: 0.4)
        }
    }

    /// `$focus`.
    var focus: Color {
        switch (scheme, tint) {
        case (.day, .slate): Color(hex: 0x3D5A80)
        case (.day, .sand): Color(hex: 0xB7791F)
        case (.day, .moss): Color(hex: 0x3F7D4E)
        case (.day, .clay): Color(hex: 0xB5543C)
        case (.night, .slate): Color(hex: 0x8FB0DC)
        case (.night, .sand): Color(hex: 0xE0B062)
        case (.night, .moss): Color(hex: 0x7CC48F)
        case (.night, .clay): Color(hex: 0xE38B72)
        }
    }

    /// `$hairline`.
    var hairline: Color {
        switch (contrast, scheme) {
        case (.normal, .day): Color(hex: 0xDDDAD3)
        case (.normal, .night): Color(hex: 0xFFFFFF, opacity: 0.122)
        case (.high, .day): Color(hex: 0x9C988F)
