// MARK: Sources/PenUI/Theme/PenTheme.swift

//
//  PenTheme.swift
//  Generated by Woodcase from the document's themes and variables. Do not edit.
//

import SwiftUI

/// The document's theme: an option on each of its axes, and its variables as they read under them.
///
/// Views read it from the environment (`@Environment(\.penTheme)`); `penTheme(…)` sets it on a subtree.
public struct PenTheme: Hashable, Sendable {
    /// The `mode` axis, which follows the colour scheme.
    public enum Mode: String, CaseIterable, Hashable, Sendable {
        case light
        case dark
    }

    /// The option on the `mode` axis.
    public var mode: Mode

    /// A theme; each axis defaults to its first option, as Pen's default theme does.
    public init(mode: Mode = .light) {
        self.mode = mode
    }
}

// MARK: Sources/PenUI/Theme/PenTheme+Environment.swift

//
//  PenTheme+Environment.swift
//  Generated by Woodcase from the document's themes. Do not edit.
//

import SwiftUI

public extension EnvironmentValues {
    /// The theme views draw with. Its `mode` is the colour scheme: reading it reads
    /// `colorScheme`, and setting it sets `colorScheme`.
    var penTheme: PenTheme {
        get {
            var theme = penThemeAxes
            theme.mode = PenTheme.Mode(colorScheme)
            return theme
        }
        set {
            penThemeAxes = newValue
            colorScheme = newValue.mode.colorScheme
        }
    }
}

extension EnvironmentValues {
    /// The theme as last set; ``penTheme`` reads its `mode` from the colour scheme instead.
    @Entry var penThemeAxes = PenTheme()
}

public extension PenTheme.Mode {
    /// The option a colour scheme selects.
    init(_ colorScheme: ColorScheme) {
        self = colorScheme == .dark ? .dark : .light
    }

    /// The colour scheme this option draws in.
    var colorScheme: ColorScheme {
        self == .dark ? .dark : .light
    }
}

public extension View {
    /// This view with the theme set on the axes named, as a .pen node's `theme` sets it for
    /// the node and everything under it; an axis left `nil` keeps the theme around the view.
    func penTheme(mode: PenTheme.Mode? = nil) -> some View {
        transformEnvironment(\.penTheme) { theme in
            if let mode { theme.mode = mode }
        }
    }
}

/// Hands its content the theme of the environment it is placed in: a subtree that sets its
/// own theme with `penTheme(…)` reads it through one, since the view around it reads its own.
public struct PenThemeReader<Content: View>: View {
    @Environment(\.penTheme) private var theme
    private let content: (PenTheme) -> Content

    /// A reader whose content is built from the theme.
    public init(@ViewBuilder content: @escaping (PenTheme) -> Content) {
        self.content = content
    }

    public var body: some View {
        content(theme)
    }
}
