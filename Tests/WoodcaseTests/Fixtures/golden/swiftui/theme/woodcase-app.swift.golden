import SwiftUI

/// The document's theme: an option on each of its axes, and its variables as they read under them.
///
/// Views read it from the environment (`@Environment(\.penTheme)`); `penTheme(…)` sets it on a subtree.
public struct PenTheme: Hashable, Sendable {
    /// The `density` axis.
    public enum Density: String, CaseIterable, Hashable, Sendable {
        case `default`
        case compact
    }

    /// The `mode` axis, which follows the colour scheme.
    public enum Mode: String, CaseIterable, Hashable, Sendable {
        case light
        case dark
    }

    /// The option on the `density` axis.
    public var density: Density
    /// The option on the `mode` axis.
    public var mode: Mode

    /// A theme; each axis defaults to its first option, as Pen's default theme does.
    public init(density: Density = .default, mode: Mode = .light) {
        self.density = density
        self.mode = mode
    }
}

public extension PenTheme {
    /// `$accent`.
    var accent: Color {
        switch mode {
        case .light: Color(hex: 0xC67A52)
        case .dark: Color(hex: 0xD4895F)
        }
    }

    /// `$accent-soft`.
    var accentSoft: Color {
        switch mode {
        case .light: Color(hex: 0xC67A52, opacity: 0.125)
        case .dark: Color(hex: 0xD4895F, opacity: 0.125)
        }
    }

    /// `$bg-card`.
    var bgCard: Color {
        switch mode {
        case .light: Color(hex: 0xFFFFFF)
        case .dark: Color(hex: 0x2A2725)
        }
    }

    /// `$bg-page`.
    var bgPage: Color {
        switch mode {
        case .light: Color(hex: 0xFAF8F4)
        case .dark: Color(hex: 0x1A1A1A)
        }
    }

    /// `$bg-warm`.
    var bgWarm: Color {
        switch mode {
        case .light: Color(hex: 0xF5F2EC)
        case .dark: Color(hex: 0x332F2B)
        }
    }

    /// `$border-default`.
    var borderDefault: Color {
        switch mode {
        case .light: Color(hex: 0xE5E2DC)
        case .dark: Color(hex: 0x3D3935)
        }
    }

    /// `$border-strong`.
    var borderStrong: Color {
        switch mode {
        case .light: Color(hex: 0xD0CCC4)
        case .dark: Color(hex: 0x4A4540)
        }
    }

    /// `$card-radius`.
    var cardRadius: CGFloat {
        switch density {
        case .default: 16
        case .compact: 10
        }
    }

    /// `$font-primary`.
    var fontPrimary: String {
        "IBM Plex Sans"
    }

    /// `$font-size-body`.
    var fontSizeBody: CGFloat {
        switch density {
        case .default: 14
        case .compact: 12
        }
    }

    /// `$shadow`.
    var shadow: Color {
        switch mode {
        case .light: Color(hex: 0xC67A52, opacity: 0.082)
        case .dark: Color(hex: 0x000000, opacity: 0.251)
        }
    }

    /// `$spacing-lg`.
    var spacingLg: CGFloat {
        switch density {
        case .default: 20
        case .compact: 14
        }
    }

    /// `$spacing-md`.
    var spacingMd: CGFloat {
        switch density {
        case .default: 16
        case .compact: 10
        }
    }

    /// `$spacing-sm`.
    var spacingSm: CGFloat {
        switch density {
        case .default: 8
        case .compact: 4
        }
    }

    /// `$status-negative`.
    var statusNegative: Color {
        switch mode {
        case .light: Color(hex: 0xC4574C)
        case .dark: Color(hex: 0xD4685E)
        }
    }

    /// `$status-positive`.
    var statusPositive: Color {
        switch mode {
        case .light: Color(hex: 0x5A9E6F)
        case .dark: Color(hex: 0x6DB882)
        }
    }

    /// `$tab-inactive`.
    var tabInactive: Color {
        switch mode {
        case .light: Color(hex: 0x9A9A9A)
        case .dark: Color(hex: 0x706B64)
        }
    }

    /// `$text-muted`.
    var textMuted: Color {
        switch mode {
        case .light: Color(hex: 0x9A9A9A)
        case .dark: Color(hex: 0x706B64)
        }
    }

    /// `$text-primary`.
    var textPrimary: Color {
        switch mode {
        case .light: Color(hex: 0x2C2C2C)
        case .dark: Color(hex: 0xF5F2EC)
        }
    }

    /// `$text-secondary`.
    var textSecondary: Color {
        switch mode {
        case .light: Color(hex: 0x6B6B6B)
        case .dark: Color(hex: 0xA09A92)
        }
    }

    /// `$white`.
    var white: Color {
