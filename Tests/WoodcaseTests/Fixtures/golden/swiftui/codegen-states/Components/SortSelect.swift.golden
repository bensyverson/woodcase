import SwiftUI

public struct SortSelect: View {
    /// The states a caller draws the view in.
    public enum Variant: String, CaseIterable, Sendable {
        case open
    }

    public let value: String
    @Binding public var selection: String
    public let options: [String]
    public let variant: Variant?

    public init(value: String = "Newest", selection: Binding<String> = .constant(""), options: [String] = [], variant: Variant? = nil) {
        self.value = value
        _selection = selection
        self.options = options
        self.variant = variant
    }

    public var body: some View {
        Menu {
            Picker(selection: $selection) {
                ForEach(options, id: \.self) { option in
                    Text(option)
                        .tag(option)
                }
            } label: {
                EmptyView()
            }
            .pickerStyle(.inline)
        } label: {
            face
        }
        .menuStyle(.button)
        .menuIndicator(.hidden)
        .buttonStyle(Style(view: self))
    }

    /// The default state.
    private var face: some View {
        HStack(spacing: 0) {
            Text(value)
                .penFont("Inter", size: 14)
                .foregroundStyle(Color(hex: 0x0F172A))
                .fixedSize()
            Spacer(minLength: 0)
            Rectangle()
                .fill(Color(hex: 0x64748B))
                .frame(width: 10, height: 6)
        }
        .padding(.horizontal, 12)
        .frame(minWidth: 0, idealWidth: 180, maxWidth: .infinity, minHeight: 0, idealHeight: 40, maxHeight: .infinity, alignment: .leading)
        .background {
            RoundedRectangle(cornerRadius: 8, style: .circular)
                .strokeBorder(Color(hex: 0xCBD5E1), lineWidth: 1)
        }
        .background(Color(hex: 0xF8FAFC), in: .rect(cornerRadius: 8, style: .circular))
    }

    /// The "open" state, as the "SortSelect:open" frame draws it.
    private var openFace: some View {
        HStack(spacing: 0) {
            Text(value)
                .penFont("Inter", size: 14)
                .foregroundStyle(Color(hex: 0x1D4ED8))
                .fixedSize()
            Spacer(minLength: 0)
            Rectangle()
                .fill(Color(hex: 0x2563EB))
                .frame(width: 10, height: 6)
        }
        .padding(.horizontal, 12)
        .frame(minWidth: 0, idealWidth: 180, maxWidth: .infinity, minHeight: 0, idealHeight: 40, maxHeight: .infinity, alignment: .leading)
        .background {
            RoundedRectangle(cornerRadius: 8, style: .circular)
                .strokeBorder(Color(hex: 0x2563EB), lineWidth: 1)
        }
        .background(Color(hex: 0xEFF6FF), in: .rect(cornerRadius: 8, style: .circular))
    }

    /// Draws the picker's label in each state: the designer's frame where there is one, the
    /// smart default's effects for the rest.
    private struct Style: ButtonStyle {
        let view: SortSelect

        func makeBody(configuration: Configuration) -> some View {
            PenStateReader(isPressed: configuration.isPressed) { state in
                Group {
                    if view.variant == .open {
                        view.openFace
                    } else {
                        configuration.label
                    }
                }
                .penFocusRing(state.contains(.focused), width: 2, offset: 2, cornerRadius: 8)
                .opacity(state.contains(.disabled) ? 0.5 : 1)
                .allowsHitTesting(!state.contains(.disabled))
            }
        }
    }
}

