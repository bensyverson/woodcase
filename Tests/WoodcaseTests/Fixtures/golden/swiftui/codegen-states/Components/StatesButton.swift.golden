import SwiftUI

public struct StatesButton: View {
    public let label: String
    public let action: () -> Void

    public init(label: String = "Continue", action: @escaping () -> Void = {}) {
        self.label = label
        self.action = action
    }

    public var body: some View {
        Button(action: action) {
            face
        }
        .buttonStyle(Style(view: self))
    }

    /// The default state.
    private var face: some View {
        HStack(spacing: 0) {
            Text(label)
                .penFont("Inter", size: 16, weight: 600)
                .foregroundStyle(Color(hex: 0xFFFFFF))
                .fixedSize()
        }
        .frame(width: 160, height: 44)
        .background(Color(hex: 0x2563EB), in: .rect(cornerRadius: 10, style: .circular))
    }

    /// The "disabled" state, as the "StatesButton:disabled" frame draws it.
    private var disabledFace: some View {
        HStack(spacing: 0) {
            Text(label)
                .penFont("Inter", size: 16, weight: 600)
                .foregroundStyle(Color(hex: 0x64748B))
                .fixedSize()
        }
        .frame(width: 160, height: 44)
        .background(Color(hex: 0xCBD5E1), in: .rect(cornerRadius: 10, style: .circular))
    }

    /// The "pressed" state, as the "StatesButton:pressed" frame draws it.
    private var pressedFace: some View {
        HStack(spacing: 0) {
            Text(label)
                .penFont("Inter", size: 16, weight: 600)
                .foregroundStyle(Color(hex: 0xBFDBFE))
                .fixedSize()
        }
        .frame(width: 160, height: 44)
        .background(Color(hex: 0x1E3A8A), in: .rect(cornerRadius: 10, style: .circular))
    }

    /// The "hover" state, as the "StatesButton:hover" frame draws it.
    private var hoverFace: some View {
        HStack(spacing: 0) {
            Text(label)
                .penFont("Inter", size: 16, weight: 600)
                .foregroundStyle(Color(hex: 0xFFFFFF))
                .fixedSize()
        }
        .frame(width: 160, height: 44)
        .background(Color(hex: 0x3B82F6), in: .rect(cornerRadius: 10, style: .circular))
    }

    /// Draws the button in each state: the designer's frame where there is one, the
    /// smart default's effects for the rest.
    private struct Style: ButtonStyle {
        let view: StatesButton

        func makeBody(configuration: Configuration) -> some View {
            PenStateReader(isPressed: configuration.isPressed) { state in
                Group {
                    if state.contains(.disabled) {
                        view.disabledFace
                    } else if state.contains(.pressed) {
                        view.pressedFace
                    } else if state.contains(.hovered) {
                        view.hoverFace
                    } else {
                        configuration.label
                    }
                }
                .penFocusRing(state.contains(.focused), width: 2, offset: 2, cornerRadius: 10)
            }
        }
    }
}

