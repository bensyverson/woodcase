import SwiftUI

public struct Switch: View {
    @Binding public var isOn: Bool

    public init(isOn: Binding<Bool> = .constant(true)) {
        _isOn = isOn
    }

    public var body: some View {
        Toggle(isOn: $isOn) {
            EmptyView()
        }
        .toggleStyle(Style(view: self))
    }

    /// The default state.
    private var face: some View {
        ZStack(alignment: .topLeading) {
            Ellipse()
                .fill(Color(hex: 0xFFFFFF))
                .frame(width: 28, height: 28)
                .offset(x: 22, y: 2)
        }
        .frame(width: 52, height: 32, alignment: .topLeading)
        .background(Color(hex: 0x22C55E), in: .rect(cornerRadius: 16, style: .circular))
    }

    /// The "off" state, as the "Switch:off" frame draws it.
    private var offFace: some View {
        ZStack(alignment: .topLeading) {
            Ellipse()
                .fill(Color(hex: 0xFFFFFF))
                .frame(width: 28, height: 28)
                .offset(x: 2, y: 2)
        }
        .frame(width: 52, height: 32, alignment: .topLeading)
        .background(Color(hex: 0xCBD5E1), in: .rect(cornerRadius: 16, style: .circular))
    }

    /// Draws the toggle in each state: the designer's frame where there is one, the
    /// smart default's effects for the rest.
    private struct Style: ToggleStyle {
        let view: Switch

        func makeBody(configuration: Configuration) -> some View {
            PenStateReader { state in
                Group {
                    if !configuration.isOn {
                        view.offFace
                    } else {
                        view.face
                    }
                }
                .opacity(state.contains(.disabled) ? 0.5 : 1)
                .allowsHitTesting(!state.contains(.disabled))
                .penFocusRing(state.contains(.focused), width: 2, offset: 2, cornerRadius: 16)
            }
            .onTapGesture {
                configuration.isOn.toggle()
            }
        }
    }
}

