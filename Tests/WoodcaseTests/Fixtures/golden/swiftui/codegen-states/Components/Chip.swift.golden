    }

    /// The "selected" state, as the "Chip selected" frame draws it.
    private var selectedFace: some View {
        HStack(alignment: .top, spacing: 0) {
            Text("Pencils")
                .penFont("Inter", size: 13)
                .foregroundStyle(Color(hex: 0xFFFFFF))
                .fixedSize()
        }
        .padding(.horizontal, 12)
        .padding(.vertical, 6)
        .background(Color(hex: 0x0F172A), in: .rect(cornerRadius: 14, style: .circular))
