//
//  PathLinHCenter.swift
//  Generated by Woodcase from the "path-lin-h-center" frame. Do not edit.
//

import SwiftUI

public struct PathLinHCenter: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            Color.clear
                .frame(width: 200, height: 100)
                .overlay {
                    SShape()
                        .stroke(.linearGradient(Gradient(stops: [.init(color: Color(hex: 0xFF0000), location: 0), .init(color: Color(hex: 0x0000FF), location: 1)]).colorSpace(.device), startPoint: .leading, endPoint: .trailing), lineWidth: 12)
                }
                .offset(x: 60, y: 60)
        }
        .frame(width: 320, height: 240, alignment: .topLeading)
        .clipped()
        .background(Color(hex: 0x000000))
    }
}

/// The "s" path's outline, drawn at 200 × 100 and fitted to the box it is offered.
private struct SShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: 0, y: 0))
        path.addLine(to: CGPoint(x: 50, y: 100))
        path.addLine(to: CGPoint(x: 100, y: 0))
        path.addLine(to: CGPoint(x: 150, y: 100))
        path.addLine(to: CGPoint(x: 200, y: 0))
        return path.penFitted(from: CGSize(width: 200, height: 100), to: rect)
    }
}

#Preview {
    PathLinHCenter()
}

