import SwiftUI

public struct GradientExtras: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            Rectangle()
                .fill(.linearGradient(Gradient(stops: [.init(color: Color(hex: 0xFF0000), location: 0), .init(color: Color(hex: 0x0000FF), location: 1)]).colorSpace(.device), startPoint: .bottom, endPoint: .top).opacity(0.5))
                .background(Color(hex: 0x00FF00), in: .rect)
                .frame(width: 120, height: 120)
                .offset(x: 30, y: 40)
            Rectangle()
                .fill(.linearGradient(Gradient(stops: [.init(color: Color(hex: 0xFFFFFF), location: 0), .init(color: Color(hex: 0x0000FF), location: 1)]).colorSpace(.device), startPoint: .bottom, endPoint: .top).blendMode(.multiply))
                .background(Color(hex: 0xFF0000), in: .rect)
                .frame(width: 120, height: 120)
                .offset(x: 200, y: 40)
        }
        .frame(width: 400, height: 200, alignment: .topLeading)
        .background(Color(hex: 0xFFFFFF))
    }
}

