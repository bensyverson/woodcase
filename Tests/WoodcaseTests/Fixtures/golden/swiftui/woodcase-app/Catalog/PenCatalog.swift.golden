//  PenCatalog.swift
//  Generated by Woodcase from the document's components, pages and theme. Do not edit.
//

import SwiftUI

/// The catalog: every component in its states, every page, the theme's tokens and the
/// document's type, in a scroll view, under the theme the toolbar's pickers set.
public struct PenCatalog: View {
    @State private var theme = PenTheme()

    public init() {}

    public var body: some View {
        GeometryReader { window in
            ScrollView([.horizontal, .vertical]) {
                PenCatalogSheet()
                    .penCatalogViewport(window.size)
                    .penTheme(density: theme.density, mode: theme.mode)
            }
        }
        .toolbar {
            Picker("density", selection: $theme.density) {
                ForEach(PenTheme.Density.allCases, id: \.self) { option in
                    Text(option.rawValue).tag(option)
                }
            }
            Picker("mode", selection: $theme.mode) {
                ForEach(PenTheme.Mode.allCases, id: \.self) { option in
                    Text(option.rawValue).tag(option)
                }
            }
        }
    }
}
