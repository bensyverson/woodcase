import SwiftUI

public struct ToggleView: View {
    @Binding public var isOn: Bool

    public init(isOn: Binding<Bool> = .constant(true)) {
        _isOn = isOn
    }

    @Environment(\.penTheme) private var theme

    public var body: some View {
        Toggle(isOn: $isOn) {
            EmptyView()
        }
        .toggleStyle(Style(view: self))
    }

    /// The default state.
    private var face: some View {
        ZStack(alignment: .topLeading) {
            Ellipse()
                .fill(theme.white)
                .frame(width: 22, height: 22)
                .offset(x: 20, y: 2)
        }
        .frame(width: 44, height: 26, alignment: .topLeading)
        .background(theme.accent, in: .rect(cornerRadius: 13, style: .circular))
    }

    /// The "off" state, as the "Toggle:off" frame draws it.
    private var offFace: some View {
        ZStack(alignment: .topLeading) {
            Ellipse()
                .fill(theme.white)
                .frame(width: 22, height: 22)
                .offset(x: 2, y: 2)
        }
        .frame(width: 44, height: 26, alignment: .topLeading)
        .background(theme.textSecondary, in: .rect(cornerRadius: 13, style: .circular))
    }

    /// Draws the toggle in each state: the designer's frame where there is one, the
    /// smart default's effects for the rest.
    private struct Style: ToggleStyle {
        let view: ToggleView

        func makeBody(configuration: Configuration) -> some View {
            PenStateReader { state in
                Group {
                    if !configuration.isOn {
                        view.offFace
                    } else {
                        view.face
                    }
                }
                .opacity(state.contains(.disabled) ? 0.5 : 1)
                .allowsHitTesting(!state.contains(.disabled))
                .penFocusRing(state.contains(.focused), width: 2, offset: 2, cornerRadius: 13)
            }
            .onTapGesture {
                configuration.isOn.toggle()
            }
        }
    }
}

