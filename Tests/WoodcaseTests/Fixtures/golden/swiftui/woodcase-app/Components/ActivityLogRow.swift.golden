import SwiftUI

public struct ActivityLogRow: View {
    public let detail: String
    public let duration: String
    public let name: String

    public init(detail: String = "Activity · Date", duration: String = "2.5 hrs", name: String = "Pencil Name") {
        self.detail = detail
        self.duration = duration
        self.name = name
    }

    @Environment(\.penTheme) private var theme

    public var body: some View {
        HStack(spacing: 12) {
            Ellipse()
                .fill(theme.accent)
                .frame(width: 8, height: 8)
            VStack(alignment: .leading, spacing: 2) {
                Text(name)
                    .penFont(theme.fontPrimary, size: 14, weight: 600)
                    .foregroundStyle(theme.textPrimary)
                    .fixedSize()
                Text(detail)
                    .penFont(theme.fontPrimary, size: 12)
                    .foregroundStyle(theme.textSecondary)
                    .fixedSize()
            }
            .frame(minWidth: 0, maxWidth: .infinity, alignment: .topLeading)
            Text(duration)
                .penFont(theme.fontPrimary, size: 14, weight: 600)
                .foregroundStyle(theme.textPrimary)
                .fixedSize()
        }
        .padding(theme.spacingMd)
        .frame(minWidth: 0, idealWidth: 354, maxWidth: .infinity, alignment: .leading)
    }
}

