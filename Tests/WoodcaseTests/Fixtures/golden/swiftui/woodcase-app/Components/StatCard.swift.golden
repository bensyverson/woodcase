import SwiftUI

public struct StatCard: View {
    public let label: String
    public let value: String

    public init(label: String = "Total Hours", value: String = "142h") {
        self.label = label
        self.value = value
    }

    @Environment(\.penTheme) private var theme

    public var body: some View {
        VStack(spacing: 4) {
            Text(value)
                .tracking(-0.5)
                .penFont(theme.fontPrimary, size: 24, weight: 600)
                .foregroundStyle(theme.textPrimary)
                .fixedSize()
            Text(label)
                .penFont(theme.fontPrimary, size: theme.fontSizeBody, weight: 500)
                .foregroundStyle(theme.textSecondary)
                .fixedSize()
        }
        .padding(theme.spacingMd)
        .frame(width: 120, alignment: .top)
        .background(theme.bgCard, in: .rect(cornerRadius: theme.cardRadius, style: .circular))
        .penDropShadow(RoundedRectangle(cornerRadius: theme.cardRadius, style: .circular), color: theme.shadow, radius: 10, x: 0, y: 4)
    }
}

#Preview {
    StatCard()
}

