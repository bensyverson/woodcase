import SwiftUI

public struct TextInput: View {
    public let label: String
    public let placeholder: String

    public init(label: String = "Label", placeholder: String = "Value") {
        self.label = label
        self.placeholder = placeholder
    }

    @Environment(\.penTheme) private var theme

    public var body: some View {
        VStack(alignment: .leading, spacing: 6) {
            Text(label)
                .penFont(theme.fontPrimary, size: 12, weight: 500)
                .foregroundStyle(theme.textSecondary)
                .fixedSize()
            HStack(alignment: .top, spacing: 0) {
                Text(placeholder)
                    .penFont(theme.fontPrimary, size: 14)
                    .foregroundStyle(theme.textMuted)
                    .fixedSize()
            }
            .padding(theme.spacingSm)
            .frame(minWidth: 0, maxWidth: .infinity, alignment: .topLeading)
            .background {
                RoundedRectangle(cornerRadius: 10, style: .circular)
                    .strokeBorder(theme.borderDefault, lineWidth: 1)
            }
            .background(theme.bgWarm, in: .rect(cornerRadius: 10, style: .circular))
        }
        .frame(width: 354, alignment: .topLeading)
    }
}

