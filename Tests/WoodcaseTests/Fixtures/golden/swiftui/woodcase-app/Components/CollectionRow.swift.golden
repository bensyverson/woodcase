import SwiftUI

public struct CollectionRow: View {
    public let meta: String
    public let name: String
    public let stars: String

    public init(meta: String = "Brand · Grade", name: String = "Pencil Name", stars: String = "★★★★★") {
        self.meta = meta
        self.name = name
        self.stars = stars
    }

    @Environment(\.penTheme) private var theme

    public var body: some View {
        HStack(spacing: 12) {
            VStack(alignment: .leading, spacing: 2) {
                Text(name)
                    .penFont(theme.fontPrimary, size: theme.fontSizeBody, weight: 600)
                    .foregroundStyle(theme.textPrimary)
                    .fixedSize()
                Text(meta)
                    .penFont(theme.fontPrimary, size: 12)
                    .foregroundStyle(theme.textSecondary)
                    .fixedSize()
            }
            .frame(minWidth: 0, maxWidth: .infinity, alignment: .topLeading)
            Text(stars)
                .penFont(theme.fontPrimary, size: 12)
                .foregroundStyle(theme.accent)
                .fixedSize()
        }
        .padding(theme.spacingMd)
        .frame(width: 354, alignment: .leading)
    }
}

