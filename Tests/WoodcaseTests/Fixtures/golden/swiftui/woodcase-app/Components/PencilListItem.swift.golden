import SwiftUI

public struct PencilListItem: View {
    public let image: Color?
    public let meta: String
    public let name: String
    public let score: String

    public init(image: Color? = nil, meta: String = "Brand · Grade", name: String = "Pencil Name", score: String = "5.0") {
        self.image = image
        self.meta = meta
        self.name = name
        self.score = score
    }

    @Environment(\.penTheme) private var theme

    public var body: some View {
        HStack(spacing: theme.spacingSm) {
            RoundedRectangle(cornerRadius: 8, style: .circular)
                .fill(image ?? theme.bgWarm)
                .frame(width: 44, height: 44)
            VStack(alignment: .leading, spacing: 2) {
                Text(name)
                    .penFont(theme.fontPrimary, size: theme.fontSizeBody, weight: 600)
                    .foregroundStyle(theme.textPrimary)
                    .fixedSize()
                Text(meta)
                    .penFont(theme.fontPrimary, size: 12)
                    .foregroundStyle(theme.textSecondary)
                    .fixedSize()
            }
            .frame(minWidth: 0, maxWidth: .infinity, alignment: .topLeading)
            HStack(spacing: 4) {
                PenIconShape(file: "lucide.ttf", glyph: 0xE176)
                    .fill(theme.accent)
                    .frame(width: 14, height: 14)
                Text(score)
                    .penFont(theme.fontPrimary, size: 13, weight: 600)
                    .foregroundStyle(theme.textPrimary)
                    .fixedSize()
            }
        }
        .padding(theme.spacingMd)
        .frame(minWidth: 0, idealWidth: 354, maxWidth: .infinity, alignment: .leading)
        .background(theme.bgCard, in: .rect(cornerRadius: theme.cardRadius, style: .circular))
        .penDropShadow(RoundedRectangle(cornerRadius: theme.cardRadius, style: .circular), color: theme.shadow, radius: 10, x: 0, y: 4)
    }
}

