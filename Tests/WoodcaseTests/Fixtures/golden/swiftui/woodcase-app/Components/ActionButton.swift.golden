import SwiftUI

public struct ActionButton: View {
    public let label: String
    public let action: () -> Void

    public init(label: String = "Button", action: @escaping () -> Void = {}) {
        self.label = label
        self.action = action
    }

    @Environment(\.penTheme) private var theme

    public var body: some View {
        Button(action: action) {
            face
        }
        .buttonStyle(Style(view: self))
    }

    /// The default state.
    private var face: some View {
        HStack(spacing: 0) {
            Text(label)
                .penFont(theme.fontPrimary, size: 14, weight: 600)
                .foregroundStyle(theme.white)
                .fixedSize()
        }
        .padding(.vertical, 14)
        .frame(minWidth: 0, idealWidth: 354, maxWidth: .infinity)
        .background(theme.accent, in: .rect(cornerRadius: 12, style: .circular))
    }

    /// Draws the button in each state: the designer's frame where there is one, the
    /// smart default's effects for the rest.
    private struct Style: ButtonStyle {
        let view: ActionButton

        func makeBody(configuration: Configuration) -> some View {
            PenStateReader(isPressed: configuration.isPressed) { state in
                configuration.label
                    .colorMultiply(Color(white: state.contains(.hovered) ? 0.95 : 1))
                    .scaleEffect(state.contains(.pressed) ? 0.98 : 1)
                    .opacity(state.contains(.disabled) ? 0.5 : 1)
                    .allowsHitTesting(!state.contains(.disabled))
                    .penFocusRing(state.contains(.focused), width: 2, offset: 2, cornerRadius: 12)
            }
        }
    }
}

