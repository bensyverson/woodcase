import SwiftUI

public struct SelectRow: View {
    public let label: String
    public let value: String
    @Binding public var selection: String
    public let options: [String]

    public init(label: String = "Setting", value: String = "Option", selection: Binding<String> = .constant(""), options: [String] = []) {
        self.label = label
        self.value = value
        _selection = selection
        self.options = options
    }

    @Environment(\.penTheme) private var theme

    public var body: some View {
        Menu {
            Picker(selection: $selection) {
                ForEach(options, id: \.self) { option in
                    Text(option)
                        .tag(option)
                }
            } label: {
                EmptyView()
            }
            .pickerStyle(.inline)
        } label: {
            face
        }
        .menuStyle(.button)
        .menuIndicator(.hidden)
        .buttonStyle(Style(view: self))
    }

    /// The default state.
    private var face: some View {
        HStack(spacing: 0) {
            Text(label)
                .penFont(theme.fontPrimary, size: 14, weight: 500)
                .foregroundStyle(theme.textPrimary)
                .fixedSize()
            Spacer(minLength: 0)
            HStack(spacing: 4) {
                Text(value)
                    .penFont(theme.fontPrimary, size: 14)
                    .foregroundStyle(theme.textSecondary)
                    .fixedSize()
                PenIconShape(file: "lucide.ttf", glyph: 0xE06F)
                    .fill(theme.textMuted)
                    .frame(width: 16, height: 16)
            }
        }
        .frame(width: 354, alignment: .leading)
    }

    /// Draws the picker's label in each state: the designer's frame where there is one, the
    /// smart default's effects for the rest.
    private struct Style: ButtonStyle {
        let view: SelectRow

        func makeBody(configuration: Configuration) -> some View {
            PenStateReader(isPressed: configuration.isPressed) { state in
                configuration.label
                    .penFocusRing(state.contains(.focused), width: 2, offset: 2, cornerRadius: 0)
                    .opacity(state.contains(.disabled) ? 0.5 : 1)
                    .allowsHitTesting(!state.contains(.disabled))
            }
        }
    }
}

