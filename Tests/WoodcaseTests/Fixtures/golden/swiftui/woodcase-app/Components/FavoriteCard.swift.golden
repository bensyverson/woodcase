import SwiftUI

public struct FavoriteCard: View {
    public let brand: String
    public let image: Image
    public let name: String

    public init(brand: String = "Brand", image: Image? = nil, name: String = "Pencil Name") {
        self.brand = brand
        self.image = image ?? Image(penResource: "generated-1774296205111.png", bundle: .module)
        self.name = name
    }

    @Environment(\.penTheme) private var theme

    public var body: some View {
        VStack(alignment: .leading, spacing: 8) {
            ZStack {
                Color.clear
                    .overlay {
                        image
                            .resizable()
                            .scaledToFill()
                    }
            }
            .frame(height: 90)
            .frame(minWidth: 0, maxWidth: .infinity)
            .clipShape(.rect(topLeadingRadius: 16, topTrailingRadius: 16, style: .circular))
            VStack(alignment: .leading, spacing: 2) {
                Text(name)
                    .penFont(theme.fontPrimary, size: 14, weight: 600)
                    .foregroundStyle(theme.textPrimary)
                    .fixedSize()
                Text(brand)
                    .penFont(theme.fontPrimary, size: 12, weight: 500)
                    .foregroundStyle(theme.textSecondary)
                    .fixedSize()
            }
            .padding(.horizontal, 12)
            .frame(minWidth: 0, maxWidth: .infinity, alignment: .topLeading)
            HStack(alignment: .top, spacing: 0) {
                PenIconShape(file: "lucide.ttf", glyph: 0xE0F2)
                    .fill(theme.accent)
                    .frame(width: 14, height: 14)
            }
            .padding(.horizontal, 12)
            .frame(minWidth: 0, maxWidth: .infinity, alignment: .topTrailing)
        }
        .padding(EdgeInsets(top: 0, leading: 0, bottom: 16, trailing: 0))
        .frame(minWidth: 0, idealWidth: 160, maxWidth: .infinity, alignment: .topLeading)
        .background(theme.bgCard, in: .rect(cornerRadius: theme.cardRadius, style: .circular))
        .penDropShadow(RoundedRectangle(cornerRadius: theme.cardRadius, style: .circular), color: theme.shadow, radius: 10, x: 0, y: 4)
    }
}

