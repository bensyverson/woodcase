        path.addCurve(to: CGPoint(x: 48, y: 8.470588), control1: CGPoint(x: 36, y: 31.058824), control2: CGPoint(x: 48, y: 19.764706))
        path.addCurve(to: CGPoint(x: 24, y: 8.470588), control1: CGPoint(x: 48, y: -2.823529), control2: CGPoint(x: 30, y: -2.823529))
        path.closeSubpath()
