/// The "Ellipse Donut" ellipse's outline, drawn at 48 × 48 and fitted to the box it is offered.
private struct EllipseDonutShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.addEllipse(in: CGRect(x: 0, y: 0, width: 48, height: 48))
        path.addEllipse(in: CGRect(x: 14.4, y: 14.4, width: 19.2, height: 19.2))
        return path.penFitted(from: CGSize(width: 48, height: 48), to: rect)
    }
}

/// The "Ellipse Arc" ellipse's outline, drawn at 48 × 48 and fitted to the box it is offered.
private struct EllipseArcShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: 24, y: 24))
        path.addArc(center: .zero, radius: 1, startAngle: .radians(0), endAngle: .radians(-4.712389), clockwise: true, transform: CGAffineTransform(translationX: 24, y: 24).scaledBy(x: 24, y: 24))
        path.closeSubpath()
        return path.penFitted(from: CGSize(width: 48, height: 48), to: rect)
    }
}

/// The "Hexagon" polygon's outline, drawn at 48 × 48 and fitted to the box it is offered.
private struct HexagonShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: 27.464102, y: 2))
        path.addArc(tangent1End: CGPoint(x: 44.78461, y: 12), tangent2End: CGPoint(x: 44.78461, y: 24), radius: 4)
        path.addArc(tangent1End: CGPoint(x: 44.78461, y: 36), tangent2End: CGPoint(x: 34.392305, y: 42), radius: 4)
        path.addArc(tangent1End: CGPoint(x: 24, y: 48), tangent2End: CGPoint(x: 13.607695, y: 42), radius: 4)
        path.addArc(tangent1End: CGPoint(x: 3.21539, y: 36), tangent2End: CGPoint(x: 3.21539, y: 24), radius: 4)
        path.addArc(tangent1End: CGPoint(x: 3.21539, y: 12), tangent2End: CGPoint(x: 13.607695, y: 6), radius: 4)
        path.addArc(tangent1End: CGPoint(x: 24, y: 0), tangent2End: CGPoint(x: 34.392305, y: 6), radius: 4)
        path.closeSubpath()
        return path.penFitted(from: CGSize(width: 48, height: 48), to: rect)
    }
}

