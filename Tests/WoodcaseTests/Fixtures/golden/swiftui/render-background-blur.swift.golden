//  Generated by Woodcase from the "flip" frame. Do not edit.
//

import SwiftUI

public struct Flip: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            Rectangle()
                .fill(Color(hex: 0xFF0000))
                .frame(width: 120, height: 240)
            Rectangle()
                .fill(Color(hex: 0x0000FF))
                .frame(width: 120, height: 240)
                .offset(x: 120, y: 0)
            Rectangle()
                .fill(Color(hex: 0x00FF00))
                .frame(width: 240, height: 40)
            Rectangle()
                .fill(Color(hex: 0xFFFFFF, opacity: 0.004))
                .frame(width: 160, height: 180)
                .penBackgroundBlur(Rectangle(), radius: 20)
                .offset(x: 40, y: 20)
        }
        .frame(width: 240, height: 240, alignment: .topLeading)
        .clipped()
        .background(Color(hex: 0xFFFFFF))
    }
}

