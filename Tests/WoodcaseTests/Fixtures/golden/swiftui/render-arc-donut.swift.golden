// MARK: Sources/PenUI/Pages/HalfThin.swift

//
//  HalfThin.swift
//  Generated by Woodcase from the "half-thin" frame. Do not edit.
//

import SwiftUI

public struct HalfThin: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            SShape()
                .fill(Color(hex: 0xFFFFFF), style: FillStyle(eoFill: true))
                .frame(width: 200, height: 120)
                .offset(x: 20, y: 20)
        }
        .frame(width: 240, height: 160, alignment: .topLeading)
        .clipped()
        .background(Color(hex: 0x000000))
    }
}

/// The "s" ellipse's outline, drawn at 200 × 120 and fitted to the box it is offered.
private struct SShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.addArc(center: .zero, radius: 1, startAngle: .radians(-3.490659), endAngle: .radians(-6.632251), clockwise: true, transform: CGAffineTransform(translationX: 100, y: 60).scaledBy(x: 100, y: 60))
        path.addArc(center: .zero, radius: 1, startAngle: .radians(-6.632251), endAngle: .radians(-3.490659), clockwise: false, transform: CGAffineTransform(translationX: 100, y: 60).scaledBy(x: 85, y: 51))
        path.closeSubpath()
        return path.penFitted(from: CGSize(width: 200, height: 120), to: rect)
    }
}

#Preview {
    HalfThin()
}

