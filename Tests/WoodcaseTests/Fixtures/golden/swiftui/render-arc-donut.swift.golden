import SwiftUI

public struct Stroked: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            Color.clear
                .frame(width: 200, height: 120)
                .overlay {
                    SShape()
                        .stroke(Color(hex: 0xFFFFFF), lineWidth: 4)
                }
                .offset(x: 20, y: 20)
