//  Generated by Woodcase from the "line-diagonal" frame. Do not edit.
//

import SwiftUI

public struct LineDiagonal: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            Color.clear
                .frame(width: 120, height: 80)
                .overlay {
                    LdiaShape()
                        .stroke(Color(hex: 0x00FF00), lineWidth: 12)
                }
                .penDropShadow(LdiaShape(), color: Color(hex: 0xFFFFFF), radius: 4, x: 10, y: 10)
                .offset(x: 50, y: 50)
        }
        .frame(width: 240, height: 200, alignment: .topLeading)
        .background(Color(hex: 0x000000))
    }
}

/// The "Ldia" line's outline, drawn at 120 × 80 and fitted to the box it is offered.
private struct LdiaShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: 0, y: 0))
        path.addLine(to: CGPoint(x: 120, y: 80))
        return path.penFitted(from: CGSize(width: 120, height: 80), to: rect)
    }
}

