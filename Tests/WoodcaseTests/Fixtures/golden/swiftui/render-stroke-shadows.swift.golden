import SwiftUI

public struct EllipseOuter: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            Ellipse()
                .fill(Color(hex: 0x808080))
                .frame(width: 120, height: 80)
                .overlay {
                    Ellipse().penStroke(.outside, lineWidth: 12)
                        .fill(Color(hex: 0x00FF00))
                }
                .penDropShadow(PenSilhouette(Ellipse(), stroke: Ellipse().penStroke(.outside, lineWidth: 12)), color: Color(hex: 0xFFFFFF), radius: 4, x: 10, y: 10)
                .offset(x: 50, y: 50)
        }
        .frame(width: 240, height: 200, alignment: .topLeading)
        .background(Color(hex: 0x000000))
    }
}

