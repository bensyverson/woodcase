//
//  PathOuter.swift
//  Generated by Woodcase from the "path-outer" frame. Do not edit.
//

import SwiftUI

public struct PathOuter: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            HoutShape()
                .fill(Color(hex: 0x808080))
                .frame(width: 120, height: 80)
                .overlay {
                    HoutShape().penStroke(.outside, lineWidth: 12)
                        .fill(Color(hex: 0x00FF00))
                }
                .penDropShadow(PenSilhouette(HoutShape(), stroke: HoutShape().penStroke(.outside, lineWidth: 12)), color: Color(hex: 0xFFFFFF), radius: 4, x: 10, y: 10)
                .offset(x: 50, y: 50)
        }
        .frame(width: 240, height: 200, alignment: .topLeading)
        .background(Color(hex: 0x000000))
    }
}

/// The "Hout" path's outline, drawn at 120 × 80 and fitted to the box it is offered.
private struct HoutShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: 0, y: 0))
        path.addLine(to: CGPoint(x: 120, y: 0))
        path.addLine(to: CGPoint(x: 60, y: 80))
        path.closeSubpath()
        return path.penFitted(from: CGSize(width: 120, height: 80), to: rect)
    }
}

