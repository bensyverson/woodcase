    PathOuter()
}

//
//  PolygonOuter.swift
//  Generated by Woodcase from the "polygon-outer" frame. Do not edit.
//

import SwiftUI

public struct PolygonOuter: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            PoutShape()
                .fill(Color(hex: 0x808080))
                .frame(width: 120, height: 80)
                .overlay {
                    PoutShape().penStroke(.outside, lineWidth: 12)
                        .fill(Color(hex: 0x00FF00))
                }
                .penDropShadow(PenSilhouette(PoutShape(), stroke: PoutShape().penStroke(.outside, lineWidth: 12)), color: Color(hex: 0xFFFFFF), radius: 4, x: 10, y: 10)
                .offset(x: 50, y: 50)
        }
        .frame(width: 240, height: 200, alignment: .topLeading)
        .background(Color(hex: 0x000000))
    }
}

/// The "Pout" polygon's outline, drawn at 120 × 80 and fitted to the box it is offered.
private struct PoutShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: 60, y: 0))
        path.addLine(to: CGPoint(x: 117.063391, y: 27.63932))
        path.addLine(to: CGPoint(x: 95.267115, y: 72.36068))
        path.addLine(to: CGPoint(x: 24.732885, y: 72.36068))
        path.addLine(to: CGPoint(x: 2.936609, y: 27.63932))
        path.closeSubpath()
        return path.penFitted(from: CGSize(width: 120, height: 80), to: rect)
    }
}

