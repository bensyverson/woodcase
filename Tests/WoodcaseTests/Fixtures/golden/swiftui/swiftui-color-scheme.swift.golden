// MARK: Sources/PenUI/Pages/ThemedMesh.swift

//
//  ThemedMesh.swift
//  Generated by Woodcase from the "themed-mesh" frame. Do not edit.
//

import SwiftUI

public struct ThemedMesh: View {
    public init() {}

    @Environment(\.penTheme) private var theme

    public var body: some View {
        Rectangle()
            .fill(PenMeshGradient(columns: 3, rows: 2, points: [[0, 0], [0.5, 0], [1, 0], [0, 1], [0.5, 1], [1, 1]], colors: [theme.meshWarm, Color(hex: 0xFFFFFF), theme.meshCool, theme.meshCool, theme.meshInk, theme.meshWarm]))
            .frame(width: 160, height: 120)
    }
}

#Preview {
    ThemedMesh()
}

#Preview("mode: dark") {
    ThemedMesh()
        .penTheme(mode: .dark)
}

