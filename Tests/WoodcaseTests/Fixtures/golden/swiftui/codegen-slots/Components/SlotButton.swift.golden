import SwiftUI

public struct SlotButton<IconContent: View>: View {
    public let label: String
    public let action: () -> Void
    private let icon: IconContent

    public init(label: String = "Send", action: @escaping () -> Void = {}, @ViewBuilder icon: () -> IconContent) {
        self.label = label
        self.action = action
        self.icon = icon()
    }

    public var body: some View {
        Button(action: action) {
            face
        }
        .buttonStyle(Style(view: self))
    }

    /// The default state.
    private var face: some View {
        HStack(spacing: 8) {
            HStack(alignment: .top, spacing: 0) {
                icon
            }
            Text(label)
                .penFont("Inter", size: 15, weight: 600)
                .foregroundStyle(Color(hex: 0xFFFFFF))
                .fixedSize()
        }
        .padding(.horizontal, 16)
        .padding(.vertical, 10)
        .background(Color(hex: 0x2563EB), in: .rect(cornerRadius: 10, style: .circular))
    }

    /// Draws the button in each state: the designer's frame where there is one, the
    /// smart default's effects for the rest.
    private struct Style: ButtonStyle {
        let view: SlotButton

        func makeBody(configuration: Configuration) -> some View {
            PenStateReader(isPressed: configuration.isPressed) { state in
                configuration.label
                    .colorMultiply(Color(white: state.contains(.hovered) ? 0.95 : 1))
                    .scaleEffect(state.contains(.pressed) ? 0.98 : 1)
                    .opacity(state.contains(.disabled) ? 0.5 : 1)
                    .allowsHitTesting(!state.contains(.disabled))
                    .penFocusRing(state.contains(.focused), width: 2, offset: 2, cornerRadius: 10)
            }
        }
    }
}

extension SlotButton where IconContent == SlotButtonIconDefault {
    /// A `SlotButton` with its slot's default content, as the component draws it.
    public init(label: String = "Send", action: @escaping () -> Void = {}) {
        self.init(label: label, action: action, icon: { SlotButtonIconDefault() })
    }
}

/// The default content of the "Icon" slot of `SlotButton`: what it draws until a caller fills it.
public struct SlotButtonIconDefault: View {
    public init() {}

    public var body: some View {
        Ellipse()
            .fill(Color(hex: 0xFFFFFF))
            .frame(width: 12, height: 12)
    }
}

