            .frame(minWidth: 0, maxWidth: .infinity, alignment: .topLeading)
        }
        .padding(16)
        .frame(width: 240, alignment: .topLeading)
        .background(Color(hex: 0xFFFFFF), in: .rect(cornerRadius: 12, style: .circular))
    }
}

