                Rectangle()
                    .fill(Color(hex: 0xFF00FF))
                    .frame(width: 80, height: 40)
                    .offset(x: 10, y: 10)
            }
            .frame(width: 0, height: 0, alignment: .topLeading)
            .background {
                PenSideStroke(EdgeInsets(top: 8, leading: 8, bottom: 8, trailing: 8), alignment: .outside).penOutset(dx: 8, dy: 8)
