            .background(Color(hex: 0x808080))
            .penDropShadow(PenSilhouette(Rectangle(), stroke: PenSideStroke(EdgeInsets(top: 8, leading: 8, bottom: 8, trailing: 8), alignment: .outside)), color: Color(hex: 0xFFFFFF), radius: 4, x: 10, y: 10, outset: CGSize(width: 8, height: 8))
            .offset(x: 50, y: 50)
        }
        .frame(width: 300, height: 300, alignment: .topLeading)
        .background(Color(hex: 0x000000))
