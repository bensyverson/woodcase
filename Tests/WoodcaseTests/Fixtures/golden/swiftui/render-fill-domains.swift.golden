// MARK: Sources/PenUI/Pages/ArcH.swift

//
//  ArcH.swift
//  Generated by Woodcase from the "arc-h" frame. Do not edit.
//

import SwiftUI

public struct ArcH: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            SShape()
                .fill(.linearGradient(Gradient(stops: [.init(color: Color(hex: 0xFF0000), location: 0), .init(color: Color(hex: 0x0000FF), location: 1)]).colorSpace(.device), startPoint: .leading, endPoint: .trailing))
                .frame(width: 200, height: 120)
                .offset(x: 20, y: 20)
        }
        .frame(width: 240, height: 160, alignment: .topLeading)
        .clipped()
        .background(Color(hex: 0x000000))
    }
}

/// The "s" ellipse's outline, drawn at 200 × 120 and fitted to the box it is offered.
private struct SShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: 100, y: 60))
        path.addArc(center: .zero, radius: 1, startAngle: .radians(0), endAngle: .radians(-1.570796), clockwise: true, transform: CGAffineTransform(translationX: 100, y: 60).scaledBy(x: 100, y: 60))
        path.closeSubpath()
        return path.penFitted(from: CGSize(width: 200, height: 120), to: rect)
    }
}

#Preview {
    ArcH()
}

