/// The "s" path's outline, drawn at 200 × 120 and fitted to the box it is offered.
private struct SShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: 0, y: 0))
        path.addLine(to: CGPoint(x: 200, y: 0))
        path.addLine(to: CGPoint(x: 200, y: 120))
        path.addLine(to: CGPoint(x: 0, y: 120))
        path.closeSubpath()
        path.move(to: CGPoint(x: 50, y: 30))
        path.addLine(to: CGPoint(x: 150, y: 30))
        path.addLine(to: CGPoint(x: 150, y: 90))
        path.addLine(to: CGPoint(x: 50, y: 90))
        path.closeSubpath()
        return path.penFitted(from: CGSize(width: 200, height: 120), to: rect)
    }
}

