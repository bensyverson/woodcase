public struct EvenoddH: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            SShape()
                .fill(.linearGradient(Gradient(stops: [.init(color: Color(hex: 0xFF0000), location: 0), .init(color: Color(hex: 0x0000FF), location: 1)]).colorSpace(.device), startPoint: .leading, endPoint: .trailing), style: FillStyle(eoFill: true))
                .frame(width: 200, height: 120)
                .offset(x: 20, y: 20)
        }
        .frame(width: 240, height: 160, alignment: .topLeading)
        .clipped()
        .background(Color(hex: 0x000000))
    }
