import SwiftUI

public struct GroupStrokePath: View {
    public init() {}

    public var body: some View {
        ZStack(alignment: .topLeading) {
            ZStack(alignment: .topLeading) {
                Rectangle()
                    .fill(Color(hex: 0xFFFFFF))
                    .frame(width: 60, height: 60)
                    .overlay {
                        Rectangle().penStroke(.outside, lineWidth: 8)
                            .fill(Color(hex: 0x333333))
                    }
                    .padding(.leading, 10)
                    .padding(.top, 10)
                WedgeShape()
                    .fill(Color(hex: 0xAA00AA))
                    .frame(width: 60, height: 60)
                    .padding(.leading, 80)
                    .padding(.top, 20)
                Color.clear
                    .frame(width: 120, height: 0)
                    .overlay {
                        RuleShape().penOutset(dx: 0, dy: 6)
                            .stroke(Color(hex: 0x008888), lineWidth: 6)
                            .padding(.vertical, -6)
                    }
                    .padding(.leading, 10)
                    .padding(.top, 110)
            }
            .penGroupShadows(outer: [PenShadowStyle(color: Color(hex: 0x0044FF, opacity: 0.8), radius: 3, x: 0, y: 12)]) {
                ZStack(alignment: .topLeading) {
                    Rectangle()
                        .fill(Color(hex: 0x000000))
                        .frame(width: 60, height: 60)
                        .overlay {
                            Rectangle().penStroke(.outside, lineWidth: 8)
                                .fill(Color(hex: 0x000000))
                        }
                        .padding(.leading, 10)
                        .padding(.top, 10)
                    WedgeShape()
                        .fill(Color(hex: 0x000000))
                        .frame(width: 60, height: 60)
                        .padding(.leading, 80)
                        .padding(.top, 20)
                }
            }
            .offset(x: 30, y: 30)
        }
        .frame(width: 200, height: 200, alignment: .topLeading)
        .clipped()
        .background(Color(hex: 0xFFFFFF))
    }
}

/// The "wedge" path's outline, drawn at 60 × 60 and fitted to the box it is offered.
private struct WedgeShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: 0, y: 60))
        path.addLine(to: CGPoint(x: 30, y: 0))
        path.addLine(to: CGPoint(x: 60, y: 60))
        path.closeSubpath()
        return path.penFitted(from: CGSize(width: 60, height: 60), to: rect)
    }
}

/// The "rule" line's outline, drawn at 120 × 0 and fitted to the box it is offered.
private struct RuleShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: 0, y: 0))
        path.addLine(to: CGPoint(x: 120, y: 0))
        return path.penFitted(from: CGSize(width: 120, height: 0), to: rect)
    }
}

