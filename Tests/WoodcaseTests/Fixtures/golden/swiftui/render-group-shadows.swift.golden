/// The "hex" polygon's outline, drawn at 70 × 70 and fitted to the box it is offered.
private struct HexShape: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: 35, y: 0))
        path.addLine(to: CGPoint(x: 65.310889, y: 17.5))
        path.addLine(to: CGPoint(x: 65.310889, y: 52.5))
        path.addLine(to: CGPoint(x: 35, y: 70))
        path.addLine(to: CGPoint(x: 4.689111, y: 52.5))
        path.addLine(to: CGPoint(x: 4.689111, y: 17.5))
        path.closeSubpath()
        return path.penFitted(from: CGSize(width: 70, height: 70), to: rect)
    }
}

