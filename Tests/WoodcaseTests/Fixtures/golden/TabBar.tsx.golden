            style={{
              color: "var(--tab-inactive)",
              fontFamily: "var(--font-primary)",
              fontSize: 10,
              fontWeight: 500,
              letterSpacing: 0.5,
              lineHeight: "13px",
              fontOpticalSizing: "none",
              whiteSpace: "pre",
              marginTop: -0.25,
              marginBottom: 0.25,
            }}
          >
            HOME
          </p>
        </div>
        <div
