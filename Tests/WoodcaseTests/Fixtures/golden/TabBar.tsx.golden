export function TabBar({
  selected,
  ...props
}: TabBarProps) {
  return (
    selected === "home" ? <TabBarHome {...props} /> :
    selected === "log" ? <TabBarLog {...props} /> :
    selected === "ratings" ? <TabBarRatings {...props} /> :
    selected === "wishlist" ? <TabBarWishlist {...props} /> :
    <TabBarDefault {...props} />
  );
}
