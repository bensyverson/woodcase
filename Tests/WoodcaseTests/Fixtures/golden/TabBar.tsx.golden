import { BookOpen, Heart, House, Star } from "lucide-react";
import { cn } from "../lib/cn";

interface TabBarProps {
  selected?: "home" | "log" | "ratings" | "wishlist";
  className?: string;
  style?: React.CSSProperties;
}

function TabBarDefault({
  className,
  style,
}: TabBarProps) {
  return (
    <nav role="tablist"
      className={cn("wc-tab-bar flex justify-center", className)}
      style={{
        width: "100%",
        padding: "12px 21px 21px 21px",
        ...style,
      }}
    >
      <div
        className="flex"
        style={{
          width: "100%",
          height: 62,
          backgroundColor: "var(--bg-card)",
          borderRadius: 36,
          padding: 4,
          boxShadow: "inset 0 0 0 1px var(--border-default), 0px 4px 20px var(--shadow)",
        }}
      >
        <div
          className="flex flex-col items-center justify-center gap-1"
          style={{
            width: "100%",
            height: "100%",
            backgroundColor: "var(--bg-card)",
            borderRadius: 26,
          }}
        >
          <House size={18} color="var(--tab-inactive)"
            style={{
              flexShrink: 0,
            }}
          />
