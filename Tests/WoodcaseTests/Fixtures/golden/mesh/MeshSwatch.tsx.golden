import { cn } from "../lib/cn";

interface MeshSwatchProps {
  className?: string;
  style?: React.CSSProperties;
}

export function MeshSwatch({
  className,
  style,
}: MeshSwatchProps) {
  return (
    <div
      className={cn("flex", className)}
      style={{
        width: 240,
        height: 180,
        background: "url('data:image/png;base64,') center / 100% 100% no-repeat",
        borderRadius: 12,
        ...style,
      }}
    >
    </div>
  );
}
