          height: "fit-content",
        }}
      >
        <Star size={14} color="var(--accent)"
          style={{
            flexShrink: 0,
          }}
        />
        <p
          style={{
            color: "var(--text-primary)",
            fontFamily: "var(--font-primary)",
            fontSize: 13,
            fontWeight: 600,
            lineHeight: "17px",
            fontOpticalSizing: "none",
            whiteSpace: "pre",
            marginTop: -0.375,
