{
  "version": "2.21",
  "children": [
    {
      "type": "frame",
      "id": "btnComp",
      "name": "Suggested Button",
      "reusable": true,
      "x": 0,
      "y": 0,
      "width": 80,
      "height": 30,
      "fill": "#2266CC"
    },
    {
      "type": "frame",
      "id": "panel",
      "name": "Panel",
      "reusable": true,
      "x": 0,
      "y": 100,
      "layout": "vertical",
      "width": 300,
      "height": 200,
      "fill": "#EEEEEE",
      "children": [
        {
          "type": "frame",
          "id": "slotNamed",
          "name": "Slot With Component",
