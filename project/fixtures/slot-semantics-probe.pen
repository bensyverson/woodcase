          "height": 60,
          "fill": "#CCFFCC",
          "slot": ["btnComp"]
        },
        {
          "type": "frame",
          "id": "slotTypes",
          "name": "Slot With Type Names",
          "layout": "vertical",
          "width": 280,
          "height": 60,
          "fill": "#FFEECC",
          "slot": ["text"]
        },
        {
          "type": "frame",
          "id": "plain",
          "name": "Plain Frame",
          "layout": "vertical",
          "width": 280,
          "height": 60,
          "fill": "#FFCCCC"
        }
      ]
    },
    {
      "type": "ref",
      "id": "inst",
